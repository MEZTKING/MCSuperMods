{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/dist-types",
      "!**/out",
      "!**/vendor",
      "!**/test/fixtures",
      "!pnpm-lock.yaml",
      "!**/*.md"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error"
      },
      "style": {
        "noEnum": "error",
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/plugin-api/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@msm/*"],
                    "message": "plugin-api has no internal dependencies"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/plugins/*/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@msm/targets", "@msm/target-*", "@msm/core", "@msm/core/*"],
                    "message": "plugins ship only against @msm/plugin-api and @msm/schemas; @msm/targets is for tests"
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/exporters/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@msm/targets", "@msm/target-*"],
                    "message": "exporters take the target from their input; @msm/targets is for tests"
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
