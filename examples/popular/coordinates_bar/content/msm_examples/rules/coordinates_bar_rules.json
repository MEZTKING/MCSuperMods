        "key": "show_coordinates",
        "name": "Show the coordinates while holding a compass",
        "only_if": {
          "conditions": [
            {
              "condition": "player_holding",
              "hand": "either",
              "item": "minecraft:compass"
            }
          ],
          "match": "all"
        },
