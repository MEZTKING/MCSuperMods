{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-types/node",
    "tsBuildInfoFile": "dist-types/node.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "src/main",
    "src/preload",
    "src/shared",
    "src/renderer/src/session/project-session.ts",
    "src/renderer/src/session/asset-files.ts",
    "src/renderer/src/session/element-defaults.ts",
    "src/renderer/src/session/mcfunction-problems.ts",
    "src/renderer/src/session/references.ts",
    "src/renderer/src/session/schema-context.ts",
    "src/renderer/src/session/importers.ts",
    "src/renderer/src/session/validator-problems.ts",
    "src/renderer/src/session/scripting-problems.ts",
    "src/renderer/src/plugins",
    "src/renderer/src/changeset",
    "src/renderer/src/ai",
    "src/renderer/src/store/ai-store.ts",
    "src/renderer/src/components/wizard/wizard-model.ts",
    "src/renderer/src/studios/completions.ts",
    "src/renderer/src/studios/templates.ts",
    "src/renderer/src/preview/model-chain.ts",
    "src/renderer/src/preview/fallback-models.ts",
    "electron.vite.config.ts",
    "vitest.config.ts",
    "e2e",
    "test"
  ],
  "exclude": ["test/components"],
  "references": [
    { "path": "../packages/plugin-api" },
    { "path": "../packages/core" },
    { "path": "../packages/interop" },
    { "path": "../packages/targets/all" }
  ]
}
