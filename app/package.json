  "description": "Desktop mod maker for Minecraft Java Edition",
  "author": "MEZTKING",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "test": "vitest run",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "smoke:packaged": "node scripts/smoke-packaged.mjs",
    "make-icon": "node scripts/make-icon.mjs"
  },
  "devDependencies": {
    "@msm/core": "workspace:*",
