  {
    "path": "data/sky/function/msm_games/world_setup/first_join.mcfunction",
    "layer": "datapack",
    "language": "mcfunction",
    "contents": [
      "# A new player's first join: runs once per player, as the player.",
      "execute unless data storage sky:msm_games {start:1b} run function sky:msm_games/world_setup/start",
      "gamemode survival @s",
      "give @s minecraft:lava_bucket 1",
      "item replace entity @s hotbar.1 with minecraft:ice 2",
      "effect give @s minecraft:slow_falling 30 0 true",
      "tellraw @s {\"text\":\"Welcome to \\\"Sky\\\" block!\"}",
      "tellraw @s {text:\"Your goals are on the Advancements screen (\",extra:[{keybind:\"key.advancements\"},\").\"]}",
      "dialog show @s minecraft:server_links",
      ""
    ]
  }
