  {
    "path": "data/sky/function/msm_games/world_setup/world_start.mcfunction",
    "layer": "datapack",
    "language": "mcfunction",
    "contents": [
      "# The world start: difficulty, game mode and game rules, set once.",
      "difficulty normal",
      "defaultgamemode survival",
      "gamerule respawn_radius 0",
      "gamerule keep_inventory true",
      "gamerule spawn_wandering_traders true",
      "data modify storage sky:msm_games world_setup set value 1b",
      ""
    ]
  },
  {
    "path": "data/sky/function/msm_games/world_setup/start.mcfunction",
    "layer": "datapack",
    "language": "mcfunction",
    "contents": [
      "# Places the start structure sky:island once for the world, at the first player's first join.",
      "forceload add 0 0 47 47",
      "place template sky:island 0 64 0",
      "forceload remove 0 0 47 47",
      "setworldspawn 2 67 2",
      "data modify storage sky:msm_games start set value 1b",
      "tp @s 2.5 67 2.5",
      ""
    ]
  },
  {
    "path": "data/sky/advancement/msm_games/first_join.json",
