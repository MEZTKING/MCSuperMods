    "lines": [
      "scoreboard players set #battle.team0 demo.msm_game 0",
      "execute store result score #battle.team0 demo.msm_game if entity @a[tag=demo.game.battle.in,team=demo.red]",
      "scoreboard players set #battle.team1 demo.msm_game 0",
      "execute store result score #battle.team1 demo.msm_game if entity @a[tag=demo.game.battle.in,team=demo.blue]",
      "scoreboard players operation #battle.min demo.msm_game = #battle.team0 demo.msm_game",
      "scoreboard players operation #battle.min demo.msm_game < #battle.team1 demo.msm_game",
