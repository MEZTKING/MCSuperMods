// MSM element data for `msm:block` and `msm:item` (ADR 0025 D5; machine recipes ADR 0075 D8), `msm:entity` (ADR 0028 D3),
// `msm:effect` (ADR 0055 D2), `msm:biome_addition` and `msm:loot_addition` (ADR 0060 D2, D3):
// the runtime definition plus editor-only fields that lower to ordinary pack files.

use super::definition::BiomeAddition as DefinitionBiomeAddition
use super::definition::BlockBehaviourComponents
use super::definition::BlockItem as DefinitionBlockItem
use super::definition::BlockCommon
use super::definition::EffectCommon
use super::definition::Breakable as DefinitionBreakable
use super::definition::Shape as DefinitionShape
use super::definition::EntityBehaviourComponents
use super::definition::EntityCommon
use super::definition::EntityRenderer
use super::definition::SpawnEgg as DefinitionSpawnEgg
use super::definition::ItemCommon
use super::definition::LootAddition as DefinitionLootAddition
use super::definition::Potion as DefinitionPotion
use super::definition::ToolTier
use super::recipe::Ingredient
use super::recipe::ItemStackTemplate

/// A tool whose mineable tag a block joins.
enum(string) BlockTool {
	Pickaxe = "pickaxe",
	Axe = "axe",
	Shovel = "shovel",
	Hoe = "hoe",
}

/// `msm:breakable` in element data: `tool` and `min_tier` lower to the mineable and
/// needs-tier tags and to `requires_tool: true`.
struct Breakable {
	...DefinitionBreakable,
	/// The tool that mines the block quickly.
	tool?: BlockTool,
	/// The lowest tool tier that gets drops.
	min_tier?: ToolTier,
}

/// A shape preset of the editor (ADR 0059 D2).
enum(string) ShapePreset {
	Full = "full",
	SlabBottom = "slab_bottom",
	SlabTop = "slab_top",
	Carpet = "carpet",
	Pillar = "pillar",
	Cross = "cross",
	Custom = "custom",
}

/// `msm:shape` in element data: `preset` is editor-only. Lowering writes the preset's `boxes`
/// (`cross` also `collision: false` unless set) and strips it; `custom` keeps `boxes`.
struct Shape {
	...DefinitionShape,
	/// The shape the editor chose; absent or `custom` means `boxes` as written.
	preset?: ShapePreset,
}

/// Block components in element data.
struct BlockComponents {
	"msm:breakable"?: Breakable,
	"msm:shape"?: Shape,
	...BlockBehaviourComponents,
}

/// Burn time in a furnace (ADR 0060 D4), lowered to the vanilla `minecraft:cooking_fuel`
/// component inside `msm:components`.
struct Fuel {
	/// Seconds the item burns (vanilla coal is 80), lowered to ticks.
	burn_seconds: float @ 0.05..,
}

/// The chance that composting the item raises the composter level (ADR 0060 D4), lowered to
/// the vanilla `minecraft:compostable` component with the target's provider for that chance.
enum(string) CompostChance {
	Chance30 = "30%",
	Chance50 = "50%",
	Chance65 = "65%",
	Chance85 = "85%",
	Chance100 = "100%",
}

/// The block item in element data: `fuel` and `compost` are editor-only and lower into the
/// item's `components` (ADR 0060 D4).
struct BlockItem {
	...DefinitionBlockItem,
	/// Makes the block item burn in a furnace.
	fuel?: Fuel,
	/// Makes the block item compostable.
	compost?: CompostChance,
}

/// Models of a block type by model slot (ADR 0067 D7), used instead of generated models from
/// `textures`. The slots are the type's own (lowering names them); the validators check them.
/// With `msm:container` the slot `open` is the model while open, and with `msm:machine` the slot
/// `lit` is the model while working (ADR 0074 D8, ADR 0075 D8); the closed or idle model is
/// used when the slot is absent.
struct BlockModels {
	[string]: #[id="model"] string,
}

/// Textures of a `pillar` (ADR 0067 D7): `all`, or `side` and `end`.
struct PillarTextures {
	/// One texture on every face.
	all?: #[id="texture"] string,
	side?: #[id="texture"] string,
	end?: #[id="texture"] string,
}

/// Textures of a `horizontal` or `directional` block (ADR 0067 D7): `all`, or `front`, `side`
/// and `top`.
struct FacingTextures {
	/// One texture on every face.
	all?: #[id="texture"] string,
	front?: #[id="texture"] string,
	side?: #[id="texture"] string,
	top?: #[id="texture"] string,
	/// The front while a player has the `msm:container` open (ADR 0074 D8), lowered to the
	/// model `<id>_open`; absent means the closed front.
	front_open?: #[id="texture"] string,
	/// The front while the `msm:machine` works (ADR 0075 D8), lowered to the model `<id>_lit`;
	/// absent means the idle front.
	front_lit?: #[id="texture"] string,
}

/// Models of a `block` by state (ADR 0074 D8, ADR 0075 D8), used with its `model`.
struct BlockStateModels {
	/// The model while a player has the `msm:container` open; absent means `model`.
	open?: #[id="model"] string,
	/// The model while the `msm:machine` works; absent means `model`.
	lit?: #[id="model"] string,
}

/// The output of a machine recipe in element data: an item id (one item) or a stack.
type MachineRecipeResult = (#[id="item"] string | ItemStackTemplate)

/// A machine recipe of an `msm:machine` block in element data (ADR 0075 D8), lowered to
/// `data/<ns>/recipe/<machine path>/<name>.json` with `type` set to the machine's id.
struct MachineRecipeEntry {
	/// The recipe file name; defaults to the result's path, with `_2`, `_3` added on a clash.
	name?: string,
	/// What the input slot must hold: an item id, an item tag (`#`-prefixed) or a list of item
	/// ids.
	ingredient: Ingredient,
	/// Inputs used per output, 1 to 64; defaults to 1.
	count?: int @ 1..64,
	/// The output.
	result: MachineRecipeResult,
	/// Ticks at speed 1, 1 to 32767; defaults to the machine's `default_time`.
	time?: int @ 1..32767,
	/// Experience stored per output; defaults to 0.
	experience?: float @ 0..,
}

/// Textures of a `slab` or `stairs` (ADR 0067 D7): `all`, or `top`, `bottom` and `side`.
struct SlabTextures {
	/// One texture on every face.
	all?: #[id="texture"] string,
	top?: #[id="texture"] string,
	bottom?: #[id="texture"] string,
	side?: #[id="texture"] string,
}

/// Textures of a `wall` (ADR 0067 D7): `all` or `texture`, or `top`, `bottom` and `side`.
struct WallTextures {
	/// One texture on every face.
	all?: #[id="texture"] string,
	/// The wall texture, as vanilla's wall templates use one.
	texture?: #[id="texture"] string,
	top?: #[id="texture"] string,
	bottom?: #[id="texture"] string,
	side?: #[id="texture"] string,
}

/// Textures of a `door` (ADR 0067 D7): `all`, or `top` and `bottom` for the two halves.
struct DoorTextures {
	/// One texture for both halves.
	all?: #[id="texture"] string,
	top?: #[id="texture"] string,
	bottom?: #[id="texture"] string,
}

/// Textures of a `trapdoor`, `button`, `pressure_plate`, `fence` or `fence_gate` (ADR 0067
/// D7): one texture, as `all` or `texture`.
struct SingleTextures {
	all?: #[id="texture"] string,
	texture?: #[id="texture"] string,
}

/// Textures of a `pane` (ADR 0067 D7): `all`, or `pane` and `edge`.
struct PaneTextures {
	/// One texture for the pane and its edge.
	all?: #[id="texture"] string,
	/// The face of the pane.
	pane?: #[id="texture"] string,
	/// The thin edge of the pane.
	edge?: #[id="texture"] string,
}

/// Textures of a `crop` (ADR 0068 D3).
struct CropTextures {
	/// One texture per age stage, from age 0; fewer textures than stages are repeated, as
	/// vanilla potatoes do.
	stages?: [#[id="texture"] string] @ 1..16,
}

/// Textures of a `sapling` (ADR 0068 D4).
struct SaplingTextures {
	/// The sapling, drawn as a cross and as the item.
	sapling?: #[id="texture"] string,
}

/// Textures of `leaves` (ADR 0068 D6).
struct LeavesTextures {
	/// The leaves texture on every face, tinted with tint index 0.
	all?: #[id="texture"] string,
}

/// A count range, `min` to `max` inclusive.
struct CountRange {
	min: int @ 0..64,
	max: int @ 0..64,
}

/// The drops of the `crop` loot preset (ADR 0068 D3), in the shape of vanilla wheat: the
/// produce at the maximum age, else the seed item.
struct CropDrops {
	/// The item harvested at the maximum age; equal to the block item for a crop planted from
	/// its produce.
	produce: #[id="item"] string,
	/// How many of the produce drop; defaults to 1.
	produce_count?: (int @ 1..64 | CountRange),
	/// Whether extra seeds drop at the maximum age, with Fortune as vanilla wheat; defaults to
	/// true.
	seed_bonus?: boolean,
}

/// An extra drop of the `leaves` loot preset, as vanilla oak leaves drop apples.
struct LeavesExtraDrop {
	item: #[id="item"] string,
	/// Chance per Fortune level, from none; defaults to vanilla's apple chances, 0.005 to
	/// 0.025.
	chances?: [float @ 0..1] @ 1..,
}

/// The drops of the `leaves` loot preset (ADR 0068 D6), in the shape of vanilla oak leaves:
/// shears or Silk Touch drop the leaves, otherwise a chance of the sapling, sticks and the extra
/// item.
struct LeavesDrops {
	/// The sapling dropped now and then; absent means none.
	sapling?: #[id="item"] string,
	/// Whether sticks drop now and then; defaults to true.
	sticks?: boolean,
	/// An extra item dropped now and then, as apples.
	extra?: LeavesExtraDrop,
}

/// Element fields of a `block` (its `model` field is the appearance).
dispatch msm:block_type_element[%none, block] to struct BlockElementFields {
	/// Models for the `open` and `lit` states of a container or machine (ADR 0074 D8, ADR 0075
	/// D8).
	models?: BlockStateModels,
}

/// Element fields of a `pillar`.
dispatch msm:block_type_element[pillar] to struct PillarElementFields {
	/// Textures of the generated models.
	textures?: PillarTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `horizontal` or `directional` block.
dispatch msm:block_type_element[horizontal, directional] to struct FacingElementFields {
	/// Textures of the generated models.
	textures?: FacingTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `slab` or `stairs`.
dispatch msm:block_type_element[slab, stairs] to struct SlabElementFields {
	/// Textures of the generated models.
	textures?: SlabTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `wall`.
dispatch msm:block_type_element[wall] to struct WallElementFields {
	/// Textures of the generated models.
	textures?: WallTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `door`.
dispatch msm:block_type_element[door] to struct DoorElementFields {
	/// Textures of the generated models.
	textures?: DoorTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `trapdoor`, `button`, `pressure_plate` or `fence_gate`.
dispatch msm:block_type_element[trapdoor, button, pressure_plate, fence_gate] to struct SingleTextureElementFields {
	/// Textures of the generated models.
	textures?: SingleTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `fence`.
dispatch msm:block_type_element[fence] to struct FenceElementFields {
	/// Textures of the generated models.
	textures?: SingleTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
	/// Whether the fence joins `#minecraft:wooden_fences` (connecting to wooden fences);
	/// defaults to true when `sound_type` is a wood sound (ADR 0067 D6).
	wooden?: boolean,
}

/// Element fields of a `pane`.
dispatch msm:block_type_element[pane] to struct PaneElementFields {
	/// Textures of the generated models.
	textures?: PaneTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of a `crop`.
dispatch msm:block_type_element[crop] to struct CropElementFields {
	/// Textures of the generated stage models.
	textures?: CropTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
	/// Drops of the `crop` loot preset; `produce` is required with that preset.
	crop_drops?: CropDrops,
	/// Whether the block item joins `#minecraft:villager_plantable_seeds`, so farmer villagers
	/// plant it; defaults to true.
	villager_plantable?: boolean,
}

/// Element fields of a `sapling`.
dispatch msm:block_type_element[sapling] to struct SaplingElementFields {
	/// Textures of the generated models.
	textures?: SaplingTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
}

/// Element fields of `leaves`.
dispatch msm:block_type_element[leaves] to struct LeavesElementFields {
	/// Textures of the generated models.
	textures?: LeavesTextures,
	/// The type's own models, used instead of `textures`.
	models?: BlockModels,
	/// Drops of the `leaves` loot preset.
	leaves_drops?: LeavesDrops,
}

/// `msm:block` element data.
struct Block {
	...BlockCommon,
	// Editor fields of the block's type (ADR 0067 D7, ADR 0068): textures, models and loot
	// preset drops, stripped in lowering.
	...msm:block_type_element[[type]],
	/// The block item; absent means a stack size of 64 in no creative tab; `false` means no
	/// block item.
	item?: (BlockItem | false),
	/// Block model, lowered to a single-variant blockstate and the block item definition. For
	/// `block`; also accepted as the single model of `pillar`, `horizontal` and `directional`.
	model?: #[id="model"] string,
	/// Display name, lowered to the `block.<ns>.<path>` language key.
	display_name?: string,
	/// `"self"` generates a loot table that drops the block (two for a double slab, the lower
	/// half of a door); `"crop"` and `"leaves"` are the presets of those types, with
	/// `crop_drops` and `leaves_drops`; an id points at a loot table element; absent means no
	/// generated table.
	loot?: ("self" | "crop" | "leaves" | #[id="loot_table"] string),
	/// Behaviour components.
	components?: BlockComponents,
	/// Recipes of the block's `msm:machine` (ADR 0075 D8), stripped from the definition and
	/// lowered to machine recipe files; only with `msm:machine`.
	recipes?: [MachineRecipeEntry],
}

/// `msm:item` element data.
struct Item {
	...ItemCommon,
	/// Item model, lowered to the item definition.
	model?: #[id="model"] string,
	/// Display name, lowered to the `item.<ns>.<path>` language key.
	display_name?: string,
	/// Makes the item burn in a furnace; lowered into `msm:components`.
	fuel?: Fuel,
	/// Makes the item compostable; lowered into `msm:components`.
	compost?: CompostChance,
}

/// `msm:animated_model` in element data: the definition's fields, with `model` and `animations`
/// naming elements of the project (ADR 0029). The ids are also the GeckoLib resource ids the
/// runtime reads, so lowering copies them unchanged.
struct AnimatedModel {
	/// An `msm:geo_model` element id, by convention `<ns>:entity/<name>`.
	model: string,
	/// An `msm:animation` element id, by convention `<ns>:entity/<name>_animations`.
	animations?: string,
	/// Texture id; `ns:entity/x` is `assets/ns/textures/entity/x.png`.
	texture: string,
	/// Render scale; defaults to 1.
	scale?: float @ 0.01..,
	/// Animation looped while idle.
	idle?: string,
	/// Animation looped while moving.
	walk?: string,
	/// Animation played once on each melee hit.
	attack?: string,
	/// Ticks to blend between animations; defaults to 0.
	transition_ticks?: int @ 0..,
	/// Defaults to `auto` (ADR 0072 D4). Runtimes older than the release that ships ADR 0072
	/// ignore the field and always use GeckoLib.
	renderer?: EntityRenderer,
	/// Animation looped while sitting (ADR 0071 D6); played before every other loop.
	sit?: string,
	/// Animation looped while moving in the air (ADR 0071 D6).
	fly?: string,
	/// Animation looped while moving in water (ADR 0071 D6).
	swim?: string,
	/// Animation played once on each ranged shot (ADR 0071 D6, ADR 0070 D4).
	shoot?: string,
}

/// Entity components in element data.
struct EntityComponents {
	"msm:animated_model": AnimatedModel,
	...EntityBehaviourComponents,
}

/// The spawn egg in element data: `texture` and `display_name` lower to the egg's item
/// definition, item model and language key.
struct SpawnEgg {
	...DefinitionSpawnEgg,
	/// Item texture such as `mymod:item/ruby_golem_spawn_egg`, lowered to
	/// `assets/<ns>/items/<path>_spawn_egg.json` and a `minecraft:item/generated` model.
	texture?: #[id="texture"] string,
	/// Display name, lowered to the `item.<ns>.<path>_spawn_egg` language key.
	display_name?: string,
}

/// `msm:entity` element data.
struct Entity {
	...EntityCommon,
	/// Display name, lowered to the `entity.<ns>.<path>` language key.
	display_name?: string,
	/// The spawn egg; absent means an egg in `minecraft:spawn_eggs`; `false` means no egg.
	spawn_egg?: (SpawnEgg | false),
	/// Behaviour components; `msm:animated_model` is required.
	components: EntityComponents,
}

/// `msm:effect` element data.
struct Effect {
	...EffectCommon,
	/// Display name, lowered to the `effect.<ns>.<path>` language key.
	display_name?: string,
}

/// Brewing of a potion: the base potion and the ingredient (ADR 0063 D3).
struct PotionBrewing {
	/// Potion the ingredient is added to; defaults to `minecraft:awkward`.
	base?: #[id="potion"] string,
	/// Ingredient item or item tag.
	reagent: #[id(registry="item", tags="allowed")] string,
}

/// The longer version of a potion (ADR 0063 D3).
struct PotionLong {
	duration_ticks: int @ 1..,
	/// Defaults to `minecraft:redstone`.
	reagent?: #[id(registry="item", tags="allowed")] string,
}

/// The stronger version of a potion (ADR 0063 D3).
struct PotionStrong {
	/// Effect level minus one.
	amplifier: int @ 0..255,
	duration_ticks: int @ 1..,
	/// Defaults to `minecraft:glowstone_dust`.
	reagent?: #[id(registry="item", tags="allowed")] string,
}

/// `msm:potion` element data: the definition plus editor fields stripped in lowering.
struct Potion {
	...DefinitionPotion,
	/// Display name, lowered to the four potion language keys.
	display_name?: string,
	brewing?: PotionBrewing,
	long?: PotionLong,
	strong?: PotionStrong,
	/// Splash version; defaults to true.
	splash?: boolean,
	/// Lingering version and tipped arrow; defaults to true.
	lingering?: boolean,
}

/// `msm:biome_addition` element data: the definition as written (ADR 0060 D2).
type BiomeAddition = DefinitionBiomeAddition

/// `msm:loot_addition` element data: the definition as written (ADR 0060 D3).
struct LootAddition {
	...DefinitionLootAddition,
}
