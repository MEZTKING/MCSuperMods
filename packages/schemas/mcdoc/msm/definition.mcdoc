// MSM definition format v1: the runtime definitions of blocks, items (ADR 0025 D2, D3),
// entities (ADR 0028 D2), mob effects (ADR 0055 D2) and additions to vanilla content (ADR 0060
// D2, D3). Lowering writes these to `msm/<ns>/block/<path>.json`, `msm/<ns>/item/<path>.json`,
// `msm/<ns>/entity/<path>.json`, `msm/<ns>/effect/<path>.json`,
// `msm/<ns>/biome_addition/<path>.json` and `msm/<ns>/loot_addition/<path>.json`.

use super::action::Event

/// A vanilla `SoundType` constant in lower case (verify the list at implementation).
enum(string) SoundType {
	Stone = "stone",
	Wood = "wood",
	Gravel = "gravel",
	Grass = "grass",
	Metal = "metal",
	Glass = "glass",
	Wool = "wool",
	Sand = "sand",
	Snow = "snow",
	Ladder = "ladder",
	Anvil = "anvil",
	SlimeBlock = "slime_block",
	HoneyBlock = "honey_block",
	CoralBlock = "coral_block",
	Bamboo = "bamboo",
	BambooWood = "bamboo_wood",
	CherryWood = "cherry_wood",
	NetherWood = "nether_wood",
	Netherrack = "netherrack",
	NetherBricks = "nether_bricks",
	NetherOre = "nether_ore",
	Basalt = "basalt",
	BoneBlock = "bone_block",
	SoulSand = "soul_sand",
	SoulSoil = "soul_soil",
	Amethyst = "amethyst",
	AmethystCluster = "amethyst_cluster",
	Calcite = "calcite",
	Tuff = "tuff",
	Deepslate = "deepslate",
	DeepslateBricks = "deepslate_bricks",
	DeepslateTiles = "deepslate_tiles",
	PolishedDeepslate = "polished_deepslate",
	Copper = "copper",
	Mud = "mud",
	MudBricks = "mud_bricks",
	PackedMud = "packed_mud",
	Moss = "moss",
	Lantern = "lantern",
	Sculk = "sculk",
}

/// Item rarity, which colours the item name.
enum(string) Rarity {
	Common = "common",
	Uncommon = "uncommon",
	Rare = "rare",
	Epic = "epic",
}

/// A tool kind.
enum(string) ToolType {
	Pickaxe = "pickaxe",
	Axe = "axe",
	Shovel = "shovel",
	Hoe = "hoe",
	Sword = "sword",
	/// A spear (ADR 0044 D3): vanilla's spear attacks with the tier's material; joins
	/// `minecraft:spears`.
	Spear = "spear",
	/// A mace (ADR 0044 D3): vanilla's smash attack with the tier's durability and enchantment
	/// value; joins the mace enchanting tags.
	Mace = "mace",
}

/// A tool tier (verify the list at implementation; validators check it against the target).
enum(string) ToolTier {
	Wood = "wood",
	Stone = "stone",
	Copper = "copper",
	Iron = "iron",
	Diamond = "diamond",
	Gold = "gold",
	Netherite = "netherite",
}

/// The block item registered with a block.
struct BlockItem {
	/// The block item's own id (ADR 0068 D2), such as seeds planting a crop; defaults to the
	/// block's id. The name key and the item model definition then follow this id.
	id?: #[id="item"] string,
	/// The creative tab that lists the item; absent means none.
	creative_tab?: #[id="creative_mode_tab"] string,
	/// Maximum stack size; defaults to 64.
	max_stack_size?: int @ 1..99,
	/// Defaults to `common`.
	rarity?: Rarity,
	/// Components of the block item (ADR 0060 D4); runtimes older than the one that ships ADR
	/// 0060 reject the field.
	components?: BlockItemComponents,
}

/// Components of a block item: the vanilla data component passthrough only.
struct BlockItemComponents {
	/// Vanilla data components by id, as on an item's `msm:components`.
	"msm:components"?: VanillaComponents,
}

/// Vanilla data components by id, each in its vanilla JSON form (ADR 0044 D1), checked against
/// the target's own component schemas.
struct VanillaComponents {
	[#[id="data_component_type"] string]: minecraft:data_component[[%key]],
}

/// Fields every block definition and block element share.
struct BlockCommon {
	/// Definition format; this is version 1.
	format: 1,
	/// The kind of block (ADR 0067 D1, ADR 0068 D1); absent means `block`, a block that is the
	/// same in every state. Each type adds its own fields, selected by this value.
	type?: BlockType,
	...msm:block_type[[type]],
	/// Sounds for breaking, placing and stepping; defaults to `stone`.
	sound_type?: SoundType,
	/// Drops; absent means the vanilla default for the block id.
	loot_table?: #[id="loot_table"] string,
	/// The block item; absent means a stack size of 64 in no creative tab; `false` means no
	/// block item.
	item?: (BlockItem | false),
	/// Events that components and actions refer to, by id.
	events?: struct BlockEvents {
		[string]: Event,
	},
}

/// How hard the block is to break. Absent means hardness 1.5, resistance 6 and no tool needed.
struct Breakable {
	/// Mining time factor; -1 makes the block unbreakable.
	hardness?: float @ -1..,
	/// Explosion resistance.
	resistance?: float @ 0..,
	/// Whether the block drops nothing unless mined with the right tool.
	requires_tool?: boolean,
}

/// Makes the block emit light.
struct LightEmitter {
	/// Light level, 0 to 15.
	level: int @ 0..15,
}

/// Fires an event when a player uses the block.
struct OnInteract {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event when an entity steps on the block.
struct OnStep {
	/// An event id declared in `events`.
	event: string,
	/// Minimum ticks between two firings; defaults to 0.
	cooldown_ticks?: int @ 0..,
}

/// Redstone behaviour. Only on the types `block`, `pillar`, `horizontal` and `directional`
/// (ADR 0067 D3); doors, gates, buttons and plates have vanilla's own `powered`.
struct Redstone {
	/// Constant signal strength the block emits, 0 to 15; defaults to 0.
	emit?: int @ 0..15,
	/// Event fired when the block becomes powered.
	on_powered?: string,
	/// Event fired when the block stops being powered.
	on_unpowered?: string,
}

/// Fires an event when a player starts breaking the block for good (`playerWillDestroy`), in
/// any game mode (ADR 0061 D2). The player is self.
struct OnBreak {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event when the block is placed by an entity (`setPlacedBy`, ADR 0061 D2). The
/// placer, when there is one, is self.
struct OnPlace {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event on a random block tick (ADR 0061 D2). The block only gets random ticks when
/// this component is present.
struct OnRandomTick {
	/// An event id declared in `events`.
	event: string,
	/// Probability that a random tick fires the event, 0 to 1; defaults to 1.
	chance?: float @ 0..1,
}

/// Fires an event when an entity is inside the block (ADR 0061 D2), as an entity can only be
/// in a block that is not full or is walk-through. Self follows the step actor rule (ADR 0058
/// D1).
struct OnEntityInside {
	/// An event id declared in `events`.
	event: string,
	/// Minimum ticks between two firings for the same entity, at least 5; defaults to 20.
	cooldown_ticks?: int @ 5..,
}

/// Block components other than `msm:breakable`, shared with the element data.
struct BlockBehaviourComponents {
	"msm:light_emitter"?: LightEmitter,
	"msm:on_interact"?: OnInteract,
	"msm:on_step"?: OnStep,
	"msm:redstone"?: Redstone,
	"msm:on_break"?: OnBreak,
	"msm:on_place"?: OnPlace,
	"msm:on_random_tick"?: OnRandomTick,
	"msm:on_entity_inside"?: OnEntityInside,
	"msm:flammable"?: Flammable,
	"msm:strippable"?: Strippable,
}

/// Makes the block catch fire and burn away (ADR 0067 D3), through Fabric's flammable block
/// registry. Vanilla planks are 5 and 20, logs 5 and 5, leaves 30 and 60.
struct Flammable {
	/// How readily fire spreads to the block, 0 to 300.
	burn_odds: int @ 0..300,
	/// How readily the block burns away once alight, 0 to 300.
	ignite_odds: int @ 0..300,
}

/// Lets an axe strip the block into another block (ADR 0067 D3), as logs turn into stripped
/// logs. Any item whose `minecraft:block_transformer` names `minecraft:axe` strips it; the axis
/// is copied when both blocks have one.
struct Strippable {
	/// The block the stripped block becomes.
	into: #[id="block"] string,
}

/// The block's outline and collision shape (ADR 0059 D1). Absent means the full solid cube.
/// Only on the types `block`, `pillar`, `horizontal` and `directional` (ADR 0067 D3); on the
/// rotating types the boxes are written for the default orientation (facing north, axis `y`)
/// and turn with the block state.
struct Shape {
	/// Pixel boxes `[x1, y1, z1, x2, y2, z2]` from 0 to 16, as model elements, joined into one
	/// shape; absent means the full cube.
	boxes?: [[float @ 0..16] @ 6] @ 1..16,
	/// Whether entities collide with the shape; defaults to true. `false` makes the block
	/// walk-through, as plants are.
	collision?: boolean,
	/// Whether the block lets light and the view of neighbouring faces through, as glass does.
	/// Defaults to true when `boxes` is present and is not the single full cube, else false.
	see_through?: boolean,
}

/// The kind of block (ADR 0067 D1, ADR 0068 D1). Every type is an ordinary `msm:block` with
/// the same item, sounds, breaking, loot and triggers; the type picks the vanilla behaviour.
enum(string) BlockType {
	/// The same in every state; the default.
	Block = "block",
	/// Turns to the clicked face's axis, as logs do.
	Pillar = "pillar",
	/// Faces one of four directions, towards the placer, as a furnace does.
	Horizontal = "horizontal",
	/// Faces one of six directions, as an observer does.
	Directional = "directional",
	/// A half block that stacks into a double slab.
	Slab = "slab",
	/// Stairs that shape into corners next to other stairs.
	Stairs = "stairs",
	/// A wall that connects to walls and solid blocks.
	Wall = "wall",
	/// A fence that connects to fences of the same kind and solid blocks.
	Fence = "fence",
	/// A gate that opens on use and fits fences and walls.
	FenceGate = "fence_gate",
	/// A two-block-high door.
	Door = "door",
	/// A trapdoor.
	Trapdoor = "trapdoor",
	/// A button that gives a short redstone pulse.
	Button = "button",
	/// A pressure plate.
	PressurePlate = "pressure_plate",
	/// A pane that connects to panes and walls, as glass panes and iron bars do.
	Pane = "pane",
	/// A crop that grows through age stages on farmland (ADR 0068 D3).
	Crop = "crop",
	/// A sapling that grows into a tree feature (ADR 0068 D4).
	Sapling = "sapling",
	/// Leaves that decay away from logs (ADR 0068 D6).
	Leaves = "leaves",
}

/// A vanilla block set type (ADR 0067 D2): sounds, whether hands open the block (not `iron`),
/// whether arrows press buttons and which entities press plates.
enum(string) BlockSetType {
	/// Oak's sounds; vanilla's oak set type on 26.3 and default wood set type on 26.4.
	Wood = "wood",
	Cherry = "cherry",
	Bamboo = "bamboo",
	Crimson = "crimson",
	Warped = "warped",
	Iron = "iron",
	Copper = "copper",
	Gold = "gold",
	Stone = "stone",
	PolishedBlackstone = "polished_blackstone",
}

/// A vanilla wood type (ADR 0067 D2), which gives a fence gate its open and close sounds.
enum(string) WoodType {
	Oak = "oak",
	Spruce = "spruce",
	Birch = "birch",
	Acacia = "acacia",
	Cherry = "cherry",
	Jungle = "jungle",
	DarkOak = "dark_oak",
	PaleOak = "pale_oak",
	Poplar = "poplar",
	Crimson = "crimson",
	Warped = "warped",
	Mangrove = "mangrove",
	Bamboo = "bamboo",
}

/// A type with no fields of its own; absent `type` means `block`.
dispatch msm:block_type[%none, block, pillar, horizontal, directional, slab, wall, fence, pane] to struct NoTypeFields {}

/// Stairs (ADR 0067 D2).
dispatch msm:block_type[stairs] to struct StairsFields {
	/// The block whose look and behaviour the stairs copy; defaults to `minecraft:stone`. It
	/// must be registered before the stairs.
	base_block?: #[id="block"] string,
}

/// A fence gate (ADR 0067 D2).
dispatch msm:block_type[fence_gate] to struct FenceGateFields {
	/// The wood type whose open and close sounds the gate plays.
	wood_type: WoodType,
}

/// A door or trapdoor (ADR 0067 D2).
dispatch msm:block_type[door, trapdoor] to struct OpeningFields {
	/// The vanilla set type; `iron` cannot be opened by hand.
	set_type: BlockSetType,
}

/// A button (ADR 0067 D2).
dispatch msm:block_type[button] to struct ButtonFields {
	/// The vanilla set type; arrows press only wooden buttons.
	set_type: BlockSetType,
	/// Ticks the button stays pressed, 1 to 200; defaults to 30 for the wooden set types and
	/// 20 otherwise, as vanilla.
	press_ticks?: int @ 1..200,
}

/// A pressure plate (ADR 0067 D2).
dispatch msm:block_type[pressure_plate] to struct PressurePlateFields {
	/// The vanilla set type; wooden plates are pressed by any entity, the others by mobs and
	/// players only.
	set_type: BlockSetType,
	/// Present: a weighted plate whose signal grows with the number of entities up to this
	/// count, as gold and iron plates; absent: an ordinary plate.
	weighted_max?: int @ 1..,
}

/// How many stages bone meal grows a crop by, picked at random from `min` to `max`.
struct BonemealGrowth {
	min: int @ 0..15,
	max: int @ 0..15,
}

/// A crop (ADR 0068 D3).
dispatch msm:block_type[crop] to struct CropFields {
	/// The last age stage, 1 to 15; the crop has `max_age + 1` stages. Defaults to 7.
	max_age?: int @ 1..15,
	/// Outline height in pixels of each stage, one per stage (`max_age + 1` entries; the
	/// validators check the length). Defaults to vanilla's ramp, `2 + 2 * stage * 7 / max_age`
	/// pixels rounded.
	stage_heights?: [int @ 1..16],
	/// The blocks the crop can be planted on; defaults to `#minecraft:supports_crops`.
	soil?: #[id(registry="block", tags="required")] string,
	/// Stages added by bone meal; defaults to vanilla's 2 to 5.
	bonemeal_growth?: BonemealGrowth,
}

/// A sapling (ADR 0068 D4). The tree features are looked up when the sapling grows; a missing
/// one is a warning at server start and the sapling does not grow.
dispatch msm:block_type[sapling] to struct SaplingFields {
	/// The configured feature grown, usually a `minecraft:tree` feature.
	tree: #[id="worldgen/feature"] string,
	/// The feature grown from four saplings in a square; absent means none.
	mega_tree?: #[id="worldgen/feature"] string,
	/// The feature grown when flowers are near, as oak's bee-nest trees; defaults to `tree`.
	flower_tree?: #[id="worldgen/feature"] string,
	/// The blocks the sapling can be planted on; defaults to `#minecraft:supports_vegetation`.
	soil?: #[id(registry="block", tags="required")] string,
}

/// A vanilla tint source for leaves (ADR 0068 D6), from the biome's colours.
enum(string) LeavesTintSource {
	Foliage = "foliage",
	Grass = "grass",
	DryFoliage = "dry_foliage",
}

/// Leaves (ADR 0068 D6). Decay needs the tree's trunk block in `#minecraft:logs`.
dispatch msm:block_type[leaves] to struct LeavesFields {
	/// Tint from a biome colour or a constant RGB colour; absent means no tint, the texture's
	/// own colours.
	tint?: (LeavesTintSource | int @ 0..16777215),
	/// Chance of a falling leaf particle per animation tick, 0 to 1; defaults to 0.01.
	particle_chance?: float @ 0..1,
	/// The falling leaf particle of untinted leaves; only without `tint`; absent means none.
	falling_particle?: #[id="particle_type"] string,
}

/// Runtime block components.
struct BlockComponents {
	"msm:breakable"?: Breakable,
	"msm:shape"?: Shape,
	...BlockBehaviourComponents,
}

/// A block definition, `msm/<ns>/block/<path>.json`.
struct Block {
	...BlockCommon,
	/// Behaviour components.
	components?: BlockComponents,
}

/// Makes the item edible.
struct Food {
	/// Hunger points restored.
	nutrition: int @ 0..,
	/// Saturation modifier.
	saturation: float @ 0..,
	/// Whether the item can be eaten when the player is not hungry.
	can_always_eat?: boolean,
}

/// A custom tool material (ADR 0042 D3), the fields of the vanilla `ToolMaterial` record.
struct ToolMaterial {
	durability: int @ 1..,
	/// Mining speed multiplier (iron is 6).
	speed: float @ 0..,
	/// Added to each tool type's base attack damage (iron is 2).
	attack_damage_bonus: float,
	/// How well the tool takes enchantments (iron is 14); 0 means it cannot be enchanted (the
	/// runtime then leaves out the `enchantable` component, since the game rejects 0).
	enchantment_value: int @ 0..,
	/// The block tag this material cannot mine for drops, such as `#minecraft:incorrect_for_iron_tool`.
	incorrect_blocks_for_drops: #[id(registry="block", tags="required")] string,
	/// An item tag whose members repair the tool.
	repair_items?: #[id(registry="item", tags="required")] string,
}

/// Makes the item a tool.
struct Tool {
	type: ToolType,
	/// A vanilla tier by name, or a custom material.
	tier: (ToolTier | ToolMaterial),
	/// Overrides the type's base attack damage (sword 3, axe 6, pickaxe 1, shovel 1.5, hoe -2;
	/// spear and mace use vanilla's values).
	attack_damage?: float,
	/// Overrides the type's base attack speed (sword -2.4, axe -3.1, pickaxe -2.8, shovel -3.0,
	/// hoe -1.0; spear and mace use vanilla's values).
	attack_speed?: float,
}

/// The slot an armour piece is worn in.
enum(string) ArmorSlot {
	Helmet = "helmet",
	Chestplate = "chestplate",
	Leggings = "leggings",
	Boots = "boots",
	/// Horse armour (ADR 0044 D5); the equipment asset needs a `horse_body` layer.
	Horse = "horse",
	/// Wolf armour (ADR 0044 D5); the equipment asset needs a `wolf_body` layer.
	Wolf = "wolf",
}

/// Vanilla armour materials by name (checked against the target's `armorMaterials` facts).
enum(string) ArmorMaterialName {
	Leather = "leather",
	Copper = "copper",
	Chainmail = "chainmail",
	Iron = "iron",
	Gold = "gold",
	Diamond = "diamond",
	Netherite = "netherite",
	TurtleScute = "turtle_scute",
	ArmadilloScute = "armadillo_scute",
}

/// A custom armour material (ADR 0042 D1), the fields of the vanilla `ArmorMaterial` record.
struct ArmorMaterial {
	/// Base durability; each slot multiplies it as vanilla does (helmet 11, chestplate 16, leggings 15, boots 13).
	durability: int @ 1..,
	/// Armour points per slot; horse and wolf armour use `body`, or the `chestplate` value
	/// without it.
	defense: struct ArmorDefense {
		helmet: int @ 0..,
		chestplate: int @ 0..,
		leggings: int @ 0..,
		boots: int @ 0..,
		/// Armour points of horse and wolf armour (vanilla iron horse armour has 5, diamond 11);
		/// defaults to `chestplate` (ADR 0050 D4).
		body?: int @ 0..,
	},
	/// How well the piece takes enchantments (iron is 9); 0 means it cannot be enchanted (the
	/// runtime then leaves out the `enchantable` component, since the game rejects 0).
	enchantment_value: int @ 0..,
	toughness: float @ 0..,
	knockback_resistance: float @ 0..1,
	/// Defaults to the generic armour equip sound.
	equip_sound?: #[id="sound_event"] string,
	/// An item tag whose members repair the piece.
	repair_items?: #[id(registry="item", tags="required")] string,
	/// The equipment asset (`assets/<ns>/equipment/<name>.json`) drawn when worn.
	equipment_asset: #[id="equipment"] string,
}

/// Makes the item an armour piece (ADR 0042 D1).
struct Armor {
	slot: ArmorSlot,
	/// A vanilla material by name, or a custom material.
	material: (ArmorMaterialName | ArmorMaterial),
}

/// Gives the item durability (on a tool or armour piece it overrides the material's); forces
/// `max_stack_size` to 1.
struct Durability {
	/// Uses before the item breaks.
	max: int @ 1..,
}

/// Fires an event when a player uses the item.
struct OnUse {
	/// An event id declared in `events`.
	event: string,
	/// Ticks before the item can be used again; defaults to 0.
	cooldown_ticks?: int @ 0..,
}

/// How a consumable is used: the animation and the sound class.
enum(string) ConsumeAnimation {
	Eat = "eat",
	Drink = "drink",
	None = "none",
}

/// One vanilla mob effect a consumable, a totem-like item or an action gives.
struct ConsumeEffect {
	/// The mob effect, such as `minecraft:regeneration`.
	effect: #[id="mob_effect"] string,
	/// Duration in seconds.
	seconds: float @ 0..,
	/// Effect level minus one; defaults to 0 (level I).
	amplifier?: int @ 0..255,
	/// Probability that the effect is applied, 0 to 1; defaults to 1.
	chance?: float @ 0..1,
}

/// Makes the item consumable (ADR 0044 D2). With `msm:food` it is food with these extras;
/// alone it is a drink or another consumable that restores no hunger.
struct Consumable {
	/// Seconds it takes to consume the item (vanilla food 1.6, a potion 1.6, a honey bottle 2).
	seconds: float @ 0..,
	animation: ConsumeAnimation,
	/// Mob effects given when the item is consumed.
	effects?: [ConsumeEffect],
	/// Sound played while consuming; defaults to the animation's vanilla sound.
	sound?: #[id="sound_event"] string,
	/// Whether item particles show while consuming; defaults to true.
	particles?: boolean,
	/// The item left after consuming, such as `minecraft:glass_bottle`.
	converts_to?: #[id="item"] string,
	/// Seconds before any item of this kind can be used again; defaults to none.
	cooldown_seconds?: float @ 0..,
}

/// The kind of a ranged weapon.
enum(string) RangedWeaponType {
	Bow = "bow",
	Crossbow = "crossbow",
}

/// Makes the item a bow or crossbow that shoots vanilla arrows (ADR 0044 D3).
struct RangedWeapon {
	type: RangedWeaponType,
	/// Draw (bow) or charge (crossbow) speed factor; defaults to 1 (vanilla).
	draw_speed?: float @ 0.1..10,
	/// Arrow speed factor; defaults to 1 (vanilla).
	velocity?: float @ 0.1..10,
	/// Factor on the arrow's base damage; defaults to 1 (vanilla).
	damage_multiplier?: float @ 0..10,
	/// Spread of the shot; defaults to vanilla's (1).
	inaccuracy?: float @ 0..10,
}

/// Makes the item block attacks while held up, like a shield (ADR 0044 D3); lowers to the
/// vanilla `blocks_attacks` component.
struct Shield {
	/// Seconds of raising before blocking starts; defaults to 0.25 (vanilla shield).
	block_delay_seconds?: float @ 0..,
	/// Fraction of the damage blocked, 0 to 1; defaults to 1 (blocks all).
	damage_reduction?: float @ 0..1,
	/// Factor on the cooldown an axe hit puts on the shield; defaults to 1.
	disable_cooldown_scale?: float @ 0..,
	/// A damage type tag that goes through the block, such as `#minecraft:bypasses_shield`.
	bypassed_by?: #[id(registry="damage_type", tags="required")] string,
}

/// Saves the holder from death like a totem of undying (ADR 0044 D4), held in either hand.
struct DeathProtection {
	/// Mob effects given when the item saves its holder.
	effects: [ConsumeEffect],
	/// Whether the holder's effects are cleared first, as the vanilla totem does; defaults to
	/// false.
	clear_effects?: boolean,
}

/// What happens to a thrown item when it lands (ADR 0056 D1).
enum(string) AfterThrow {
	/// Each throw uses one item from the stack, as a snowball does.
	Consume = "consume",
	/// The stack keeps its item; the thrown copy disappears when it lands.
	Keep = "keep",
	/// The thrown item drops where it lands and can be picked up again, as a throwing knife.
	Drop = "drop",
	/// The thrown item goes back into the thrower's inventory when it lands, or drops at their
	/// feet when it does not fit (no return flight).
	Return = "return",
}

/// An event fired when a thrown item hits something.
struct OnThrownHit {
	/// An event id declared in `events`.
	event: string,
}

/// Makes the item throwable (ADR 0056 D1): using it throws a copy that flies as the shared
/// `msm_runtime:thrown_item` entity and is drawn as the item's picture. Runtimes older than
/// 1.4.0 ignore the component.
struct Throwable {
	/// Launch speed in blocks per tick; defaults to 1.5 (a snowball; a trident is 2.5).
	speed?: float @ 0.1..5,
	/// Spread of the throw; defaults to 1.
	inaccuracy?: float @ 0..10,
	/// Downward acceleration in blocks per tick squared; defaults to 0.03 (a snowball).
	gravity?: float @ 0..1,
	/// Damage in half hearts dealt to the entity hit, as thrown damage by the thrower; defaults
	/// to 0.
	damage?: float @ 0..,
	/// Ticks the player must hold use before releasing throws (a trident needs 10); defaults to
	/// 0, which throws at once.
	charge_ticks?: int @ 0..200,
	/// Defaults to `consume`. `keep`, `drop` and `return` take one durability per throw when the
	/// item has `msm:durability`.
	after_throw?: AfterThrow,
	/// Ticks before the item can be thrown again; defaults to 0.
	cooldown_ticks?: int @ 0..,
	/// Sound played on throwing; defaults to `minecraft:entity.snowball.throw`.
	sound?: #[id="sound_event"] string,
	/// Whether a dispenser throws the item; defaults to true.
	dispensable?: boolean,
	/// Fires when the thrown item hits an entity, after `damage`; `other` is the entity hit.
	on_hit_entity?: OnThrownHit,
	/// Fires when the thrown item hits a block.
	on_hit_block?: OnThrownHit,
}

/// Fires an event after the holder hits an entity with the item (`postHurtEnemy`, ADR 0061
/// D1). Self is the attacker, player or mob; `other` is the entity hit.
struct OnHit {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event when a player uses the item on a block (`useOn`, ADR 0061 D1); `base` and
/// `block` are the clicked block.
struct OnUseOnBlock {
	/// An event id declared in `events`.
	event: string,
	/// Ticks before the item can be used again; defaults to 0.
	cooldown_ticks?: int @ 0..,
}

/// The hand a held item fires in.
enum(string) HeldHand {
	Main = "main",
	Off = "off",
	Either = "either",
}

/// Fires an event repeatedly while an entity holds the item (ADR 0061 D1).
struct WhileHeld {
	/// An event id declared in `events`.
	event: string,
	/// Ticks between two firings, at least 5; defaults to 20.
	interval_ticks?: int @ 5..,
	/// Defaults to `main`.
	hand?: HeldHand,
}

/// Fires an event repeatedly while an entity wears the item in the armour slot of its
/// `msm:armor` (ADR 0061 D1); without `msm:armor` it is an error (checked by the validators).
struct WhileWorn {
	/// An event id declared in `events`.
	event: string,
	/// Ticks between two firings, at least 5; defaults to 20.
	interval_ticks?: int @ 5..,
}

/// Runtime item components.
struct ItemComponents {
	"msm:food"?: Food,
	"msm:tool"?: Tool,
	/// An armour piece; not together with `msm:tool`, `msm:ranged_weapon`, `msm:shield` or
	/// `msm:throwable` (checked by the validators).
	"msm:armor"?: Armor,
	"msm:durability"?: Durability,
	"msm:on_use"?: OnUse,
	/// Eating or drinking: effects, time, sound, the item left over and a cooldown.
	"msm:consumable"?: Consumable,
	/// A bow or crossbow; not together with `msm:tool`, `msm:armor`, `msm:shield` or
	/// `msm:throwable`.
	"msm:ranged_weapon"?: RangedWeapon,
	/// Blocks attacks; not together with `msm:tool`, `msm:armor`, `msm:ranged_weapon` or
	/// `msm:throwable`.
	"msm:shield"?: Shield,
	/// Thrown on use; not together with `msm:armor`, `msm:ranged_weapon`, `msm:shield`,
	/// `msm:consumable`, `msm:food` or a `mace` tool (checked by the validators).
	"msm:throwable"?: Throwable,
	/// Saves the holder from death.
	"msm:death_protection"?: DeathProtection,
	/// Fires after a hit with the item.
	"msm:on_hit"?: OnHit,
	/// Fires when the item is used on a block.
	"msm:on_use_on_block"?: OnUseOnBlock,
	/// Fires repeatedly while the item is held.
	"msm:while_held"?: WhileHeld,
	/// Fires repeatedly while the item is worn; needs `msm:armor`.
	"msm:while_worn"?: WhileWorn,
	/// Vanilla data components by id, each in its vanilla JSON form (ADR 0044 D1), checked
	/// against the target's own component schemas. MSM's own components win: a vanilla
	/// component that an MSM component also sets is an error (checked by the validators).
	"msm:components"?: VanillaComponents,
}

/// Fields every item definition and item element share.
struct ItemCommon {
	/// Definition format; this is version 1.
	format: 1,
	/// Maximum stack size; defaults to 64.
	max_stack_size?: int @ 1..99,
	/// Defaults to `common`.
	rarity?: Rarity,
	/// The creative tab that lists the item; absent means none.
	creative_tab?: #[id="creative_mode_tab"] string,
	/// Behaviour components.
	components?: ItemComponents,
	/// Events that components refer to, by id.
	events?: struct ItemEvents {
		[string]: Event,
	},
}

/// An item definition, `msm/<ns>/item/<path>.json`.
struct Item {
	...ItemCommon,
}

/// A vanilla `MobCategory` in lower case: the spawn group that caps how many such mobs exist.
enum(string) MobCategory {
	Monster = "monster",
	Creature = "creature",
	Ambient = "ambient",
	WaterCreature = "water_creature",
	WaterAmbient = "water_ambient",
	UndergroundWaterCreature = "underground_water_creature",
	Axolotls = "axolotls",
	Misc = "misc",
}

/// Where a natural spawn may be placed (vanilla `SpawnPlacementTypes`).
enum(string) SpawnPlacement {
	OnGround = "on_ground",
	InWater = "in_water",
	InLava = "in_lava",
	NoRestrictions = "no_restrictions",
}

/// The heightmap a natural spawn position is taken from (vanilla `Heightmap.Types`).
enum(string) Heightmap {
	MotionBlockingNoLeaves = "motion_blocking_no_leaves",
	MotionBlocking = "motion_blocking",
	WorldSurface = "world_surface",
	OceanFloor = "ocean_floor",
}

/// The vanilla spawn check a natural spawn must pass.
enum(string) SpawnRule {
	/// `Mob.checkMobSpawnRules`.
	Mob = "mob",
	/// `Monster.checkMonsterSpawnRules`: dark enough, not peaceful.
	Monster = "monster",
	/// `Monster.checkSurfaceMonstersSpawnRules`.
	SurfaceMonster = "surface_monster",
	/// `Monster.checkAnyLightMonsterSpawnRules`.
	AnyLightMonster = "any_light_monster",
	/// No check beyond the placement.
	Always = "always",
	/// The animal check (ADR 0070 D6): grass-like ground under the mob and enough light. The
	/// runtime repeats it for any `base`, since vanilla binds `Animal.checkAnimalSpawnRules` to
	/// animals. Runtimes older than the release that ships ADR 0070 reject the value, and the
	/// entity does not register.
	Animal = "animal",
	/// The surface water check (ADR 0070 D6): in water near the surface, as vanilla's water
	/// animals; repeated by the runtime for any `base`. Runtimes older than the release that ships
	/// ADR 0070 reject the value, and the entity does not register.
	WaterAnimal = "water_animal",
}

/// The vanilla class a mob builds on (ADR 0070 D1). The class changes vanilla behaviour beyond
/// the components (wander preferences, despawning, iron golems), so it is chosen explicitly and
/// stays separate from `category`.
enum(string) EntityBase {
	/// A plain `PathfinderMob`: every entity before ADR 0070.
	Mob = "mob",
	/// `TamableAnimal`: ages, babies, breeding, leads and animal spawn checks; taming stays off
	/// unless `msm:tameable` is present. Needed by `msm:tameable` and `msm:breedable`.
	Animal = "animal",
	/// `Monster`: an enemy that iron golems attack, stops players sleeping nearby, plays hostile
	/// sounds and is removed in peaceful.
	Monster = "monster",
}

/// How a mob moves (ADR 0070 D3).
enum(string) MovementMode {
	/// Walks on the ground, as before ADR 0070.
	Walk = "walk",
	/// Flies: no gravity and no fall damage; `wander` strolls through the air.
	Fly = "fly",
	/// Swims: lives in water, `wander` swims about, no float goal; out of water it flops and dries
	/// out unless `breathes_air`.
	Swim = "swim",
	/// Walks on land and swims in water, breathing both; `wander` stays the walking stroll.
	Amphibious = "amphibious",
}

/// The entity's hitbox in blocks.
struct EntitySize {
	width: float @ 0.1..8,
	height: float @ 0.1..8,
}

/// The spawn egg registered with an entity as the item `<ns>:<path>_spawn_egg`.
struct SpawnEgg {
	/// The creative tab that lists the egg; defaults to `minecraft:spawn_eggs`.
	creative_tab?: #[id="creative_mode_tab"] string,
}

/// Natural spawning in biomes, registered in the entity's `category`.
struct Spawn {
	/// Biome ids and biome tags (`#`-prefixed); the spawn applies to their union.
	biomes: [#[id(registry="worldgen/biome", tags="allowed")] string],
	/// Spawn weight relative to the other spawns of the category.
	weight: int @ 1..,
	/// Smallest group size.
	min_group: int @ 1..,
	/// Largest group size; at least `min_group` (checked by the validators).
	max_group: int @ 1..,
	/// Defaults to `on_ground`.
	placement?: SpawnPlacement,
	/// Defaults to `motion_blocking_no_leaves`.
	heightmap?: Heightmap,
	/// Defaults to `mob`.
	rule?: SpawnRule,
}

/// Maximum health; absent means 20.
struct Health {
	/// Maximum health in half hearts.
	max: float @ 1..,
}

/// Movement attributes. Absent means speed 0.25, follow range 16, no knockback resistance,
/// swims, not fire immune and walking. Runtimes older than the release that ships ADR 0070
/// ignore `mode`, `flying_speed`, `hovers`, `breathes_air`, `dry_out_ticks` and `step_height`.
struct Movement {
	/// The `movement_speed` attribute.
	speed?: float @ 0..,
	/// The `follow_range` attribute, in blocks.
	follow_range?: float @ 0..,
	/// The `knockback_resistance` attribute, 0 to 1.
	knockback_resistance?: float @ 0..1,
	/// Whether the mob floats up in water (adds a float goal first); for `walk` and `fly` only.
	swims?: boolean,
	/// Whether the mob ignores fire and lava damage.
	fire_immune?: boolean,
	/// How the mob moves (ADR 0070 D3); defaults to `walk`.
	mode?: MovementMode,
	/// The `flying_speed` attribute, used by `fly`; defaults to 0.4, a parrot's (a bee's is
	/// 0.6).
	flying_speed?: float @ 0..,
	/// `fly` only: whether the mob stays in place when idle, as a bee; defaults to true.
	hovers?: boolean,
	/// `swim` only: whether the mob needs to surface for air, as a dolphin; defaults to false.
	breathes_air?: boolean,
	/// `swim` without `breathes_air`: ticks out of water before the mob starts losing health;
	/// defaults to 300, as vanilla's water animals (verify at implementation).
	dry_out_ticks?: int @ 20..,
	/// The `step_height` attribute in blocks; absent keeps vanilla's 0.6.
	step_height?: float @ 0..10,
}

/// Ranged attacks (ADR 0070 D4), used by the `ranged_attack` goal as `msm:attack` is by
/// `melee_attack`. Runtimes older than the release that ships ADR 0070 ignore the component with
/// a warning.
struct RangedAttack {
	/// The projectile: `minecraft:arrow`, `minecraft:tipped_arrow` or `minecraft:spectral_arrow`
	/// (shot as a mob's arrow from a bow), another vanilla projectile item of the target, or a
	/// project item with `msm:throwable` (thrown with the mob as thrower, so its damage, gravity
	/// and hit events apply). Anything else is a load error that drops the component.
	projectile: #[id="item"] string,
	/// Arrows only: base damage, as `setBaseDamage` (a hit deals about damage times speed,
	/// rounded up); defaults to 2.
	damage?: float @ 0..,
	/// Launch speed in blocks per tick; defaults to 1.6 (a skeleton's arrow).
	speed?: float @ 0.1..5,
	/// Spread of the shot; defaults to 6.
	inaccuracy?: float @ 0..20,
	/// Ticks between shots; defaults to 40.
	interval_ticks?: int @ 5..,
	/// Ticks spent aiming before a shot (the bow pose); defaults to 20.
	charge_ticks?: int @ 0..200,
	/// Range in blocks; defaults to 15.
	range?: float @ 1..64,
	/// Sound played on each shot; defaults to `minecraft:entity.skeleton.shoot`.
	sound?: #[id="sound_event"] string,
	/// Event fired after each shot; `other` is the target.
	on_shoot?: string,
}

/// Melee attack attributes; absent means no melee damage.
struct Attack {
	/// The `attack_damage` attribute.
	damage: float @ 0..,
	/// The `attack_knockback` attribute.
	knockback?: float @ 0..,
	/// Event fired after a successful melee hit.
	on_attack?: string,
}

/// The kind of an AI goal. The runtime drops a goal of an unknown kind with an error; the entity still registers.
enum(string) GoalType {
	/// Strolls about (`WaterAvoidingRandomStrollGoal` or `RandomStrollGoal`).
	Wander = "wander",
	/// Looks at a nearby player.
	LookAtPlayer = "look_at_player",
	/// Looks around at random.
	LookAround = "look_around",
	/// Attacks the listed entity types in melee.
	MeleeAttack = "melee_attack",
	/// Runs away from the listed entity types.
	Flee = "flee",
	/// Follows the nearest of the listed entity types.
	Follow = "follow",
	/// Shoots at the listed entity types; needs `msm:ranged_attack` (ADR 0070 D5).
	RangedAttack = "ranged_attack",
	/// Follows players holding one of the listed items (`TemptGoal`, ADR 0070 D5).
	Tempt = "tempt",
	/// Runs about when hurt or burning (`PanicGoal`, ADR 0070 D5).
	Panic = "panic",
	/// Leaps at its attack target (`LeapAtTargetGoal`, ADR 0070 D5).
	LeapAtTarget = "leap_at_target",
}

/// One AI goal, selected by `type`.
struct Goal {
	/// What the goal does.
	type: GoalType,
	/// Goal priority, lower runs first; defaults to the goal's position in the list.
	priority?: int @ 0..,
	...msm:ai_goal[[type]],
}

/// Strolls about at random.
dispatch msm:ai_goal[wander] to struct WanderGoal {
	/// Speed multiplier; defaults to 1.
	speed?: float @ 0..,
	/// Whether to keep out of water; defaults to true.
	avoid_water?: boolean,
}

/// Looks at the nearest player in range.
dispatch msm:ai_goal[look_at_player] to struct LookAtPlayerGoal {
	/// Range in blocks; defaults to 8.
	distance?: float @ 0..,
}

/// Looks around at random.
dispatch msm:ai_goal[look_around] to struct LookAroundGoal {}

/// Attacks entities in melee; needs `msm:attack`.
dispatch msm:ai_goal[melee_attack] to struct MeleeAttackGoal {
	/// Speed multiplier while chasing; defaults to 1.
	speed?: float @ 0..,
	/// Entity types to attack; `minecraft:player` matches players. Absent or empty with
	/// `retaliate` only fights back.
	targets?: [#[id="entity_type"] string],
	/// Whether a target must be in sight; defaults to true.
	must_see?: boolean,
	/// Whether to fight back when hurt; defaults to false.
	retaliate?: boolean,
}

/// Runs away from entities of the listed types.
dispatch msm:ai_goal[flee] to struct FleeGoal {
	/// Entity types to run from.
	from: [#[id="entity_type"] string],
	/// Range in blocks; defaults to 6.
	distance?: float @ 0..,
	/// Speed multiplier when the threat is far; defaults to 1.
	speed?: float @ 0..,
	/// Speed multiplier when the threat is near; defaults to 1.2.
	sprint_speed?: float @ 0..,
}

/// Follows the nearest entity of the listed types.
dispatch msm:ai_goal[follow] to struct FollowGoal {
	/// Entity types to follow; `minecraft:player` matches players.
	entities: [#[id="entity_type"] string],
	/// Speed multiplier; defaults to 1.
	speed?: float @ 0..,
	/// Distance in blocks at which the mob stops; defaults to 2.
	stop_distance?: float @ 0..,
	/// Search range in blocks; defaults to 16.
	range?: float @ 0..,
}

/// Shoots at entities with the mob's `msm:ranged_attack` (ADR 0070 D5): approaches until within
/// range and in sight, aims for `charge_ticks`, shoots, then waits `interval_ticks`. Without
/// `msm:ranged_attack` the goal adds nothing. Runtimes older than the release that ships ADR 0070
/// drop the goal with an error.
dispatch msm:ai_goal[ranged_attack] to struct RangedAttackGoal {
	/// Speed multiplier while approaching; defaults to 1.
	speed?: float @ 0..,
	/// Whether the mob circles its target while shooting, as a skeleton; defaults to false.
	strafe?: boolean,
	/// Entity types to shoot at; `minecraft:player` matches players. Absent or empty with
	/// `retaliate` only fights back.
	targets?: [#[id="entity_type"] string],
	/// Whether a target must be in sight; defaults to true.
	must_see?: boolean,
	/// Whether to fight back when hurt; defaults to false.
	retaliate?: boolean,
}

/// Follows players holding one of the listed items (`TemptGoal`, ADR 0070 D5). Runtimes older
/// than the release that ships ADR 0070 drop the goal with an error.
dispatch msm:ai_goal[tempt] to struct TemptGoal {
	/// Items and item tags (`#`-prefixed) that tempt the mob.
	items: [#[id(registry="item", tags="allowed")] string],
	/// Speed multiplier; defaults to 1.
	speed?: float @ 0..,
	/// Whether a player moving quickly scares the mob off, as a chicken's; defaults to false.
	scared?: boolean,
}

/// Runs about when hurt or burning (`PanicGoal`, ADR 0070 D5). Runtimes older than the release
/// that ships ADR 0070 drop the goal with an error.
dispatch msm:ai_goal[panic] to struct PanicGoal {
	/// Speed multiplier; defaults to 1.25.
	speed?: float @ 0..,
}

/// Leaps at the attack target when close, as a spider (`LeapAtTargetGoal`, ADR 0070 D5).
/// Runtimes older than the release that ships ADR 0070 drop the goal with an error.
dispatch msm:ai_goal[leap_at_target] to struct LeapAtTargetGoal {
	/// Upward speed of the leap in blocks per tick; defaults to 0.4.
	height?: float @ 0..,
}

/// The mob's AI goals.
struct AiGoals {
	/// Goals in priority order.
	goals: [Goal],
}

/// Which renderer draws the entity (ADR 0072 D4).
enum(string) EntityRenderer {
	/// GeckoLib when it is loaded, the runtime's vanilla renderer otherwise (such as on 26.4).
	Auto = "auto",
	/// GeckoLib only: the entity does not register without GeckoLib.
	Geckolib = "geckolib",
	/// The runtime's vanilla renderer, never GeckoLib. It plays a subset of GeckoLib's animation
	/// features: no Molang, no easings, no sound or particle keyframes.
	Vanilla = "vanilla",
}

/// The model, animations and texture the entity renders with (ADR 0029). Required: the
/// GeckoLib resources serve both renderers (ADR 0072 D1).
struct AnimatedModel {
	/// Geo model id; `ns:entity/x` is `assets/ns/geckolib/models/entity/x.geo.json`.
	model: string,
	/// Animation set id; `ns:entity/x_animations` is
	/// `assets/ns/geckolib/animations/entity/x_animations.animation.json`.
	animations?: string,
	/// Texture id; `ns:entity/x` is `assets/ns/textures/entity/x.png`.
	texture: string,
	/// Render scale; defaults to 1.
	scale?: float @ 0.01..,
	/// Animation looped while idle.
	idle?: string,
	/// Animation looped while moving.
	walk?: string,
	/// Animation played once on each melee hit.
	attack?: string,
	/// Ticks to blend between animations; defaults to 0.
	transition_ticks?: int @ 0..,
	/// Defaults to `auto` (ADR 0072 D4). Runtimes older than the release that ships ADR 0072
	/// ignore the field and always use GeckoLib.
	renderer?: EntityRenderer,
	/// Animation looped while sitting (ADR 0071 D6); played before every other loop.
	sit?: string,
	/// Animation looped while moving in the air (ADR 0071 D6).
	fly?: string,
	/// Animation looped while moving in water (ADR 0071 D6).
	swim?: string,
	/// Animation played once on each ranged shot (ADR 0071 D6, ADR 0070 D4).
	shoot?: string,
}

/// Fires an event after the entity takes damage.
struct OnHurt {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event when the entity dies.
struct OnDeath {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event repeatedly while the mob is alive (`customServerAiStep`, ADR 0061 D3).
struct OnEntityTick {
	/// An event id declared in `events`.
	event: string,
	/// Ticks between two firings, at least 5; defaults to 20.
	interval_ticks?: int @ 5..,
}

/// Fires an event when the mob spawns naturally, from an egg or from a spawner
/// (`finalizeSpawn`, ADR 0061 D3); not when its chunk loads.
struct OnSpawn {
	/// An event id declared in `events`.
	event: string,
}

/// How a tamed mob follows its owner (vanilla `FollowOwnerGoal`).
struct TameableFollow {
	/// Speed multiplier; defaults to 1.
	speed?: float @ 0..,
	/// Distance in blocks at which the mob starts following; defaults to 10.
	start_distance?: float @ 0..,
	/// Distance in blocks at which the mob stops; defaults to 2.
	stop_distance?: float @ 0..,
}

/// Makes the mob tameable as vanilla's wolf (ADR 0071 D1); needs `base` `animal`, otherwise a
/// load error that drops the component. Feeding a taming item uses it up (not in creative) and
/// tames with `chance`: hearts on success, smoke on failure. Tamed mobs teleport to an owner who
/// is far away and do not despawn. Runtimes older than the release that ships ADR 0071 ignore
/// the component with a warning.
struct Tameable {
	/// Taming items and item tags (`#`-prefixed).
	items: [#[id(registry="item", tags="allowed")] string],
	/// Chance per item; defaults to 0.33 (a wolf's bone).
	chance?: float @ 0..1,
	/// Whether the owner's right click toggles sitting; defaults to true.
	sit?: boolean,
	/// Whether the mob follows its owner; defaults to true.
	follows_owner?: boolean,
	/// How the mob follows its owner; defaults to speed 1, start 10 and stop 2 (a wolf's).
	follow?: TameableFollow,
	/// Whether the mob attacks what hurts its owner and what its owner attacks; defaults to true.
	defends_owner?: boolean,
	/// Maximum health in half hearts once tamed; absent keeps `msm:health`.
	tamed_health?: float @ 1..,
	/// Event fired when the mob is tamed; `player` is the new owner.
	on_tame?: string,
}

/// Makes the mob breed and have babies as vanilla's farm animals (ADR 0071 D2); needs `base`
/// `animal`, otherwise a load error that drops the component. A baby is the same type and takes
/// a random parent's variant. Natural spawns and spawn eggs make adults; a spawn egg used on an
/// adult makes a baby. Runtimes older than the release that ships ADR 0071 ignore the component
/// with a warning.
struct Breedable {
	/// Breeding items and item tags (`#`-prefixed); feeding one to a baby makes it grow.
	items: [#[id(registry="item", tags="allowed")] string],
	/// Size of a baby relative to an adult (hitbox and model); defaults to 0.5.
	baby_scale?: float @ 0.1..1,
	/// Ticks a baby takes to grow up; defaults to 24000 (a vanilla baby's 20 minutes).
	grow_up_ticks?: int @ 1..,
	/// Whether the breeding items tempt the mob; defaults to true.
	tempted?: boolean,
	/// Whether babies follow their parents; defaults to true.
	follow_parents?: boolean,
	/// Event fired when a baby is born; self is the baby, `player` who bred the parents.
	on_breed?: string,
}

/// Who may steer a ridden mob.
enum(string) RideControl {
	/// Any rider.
	Anyone = "anyone",
	/// The owner only; needs `msm:tameable`.
	Owner = "owner",
}

/// Makes the mob rideable (ADR 0071 D3), on any `base`. An empty hand mounts it and sneaking
/// dismounts. The first passenger steers when the mob is saddled (or `saddle` is false) and
/// `controlled_by` allows it: `walk` and `amphibious` mobs jump with a jump bar when `jump` is
/// above 0, `fly` mobs fly along the rider's view and rise while jump is held, `swim` mobs follow
/// the rider's view under water. A ridden mob is moved by the rider's game. Runtimes older than
/// the release that ships ADR 0071 ignore the component with a warning.
struct Rideable {
	/// Whether a vanilla saddle is needed to steer; defaults to true. A saddled mob joins the
	/// `#minecraft:can_equip_saddle` entity type tag.
	saddle?: boolean,
	/// Defaults to `anyone`.
	controlled_by?: RideControl,
	/// Ridden speed as a factor of the movement speed; defaults to 1.
	speed?: float @ 0..,
	/// Jump strength (the `jump_strength` attribute); 0 means no jump; defaults to 0.
	jump?: float @ 0..,
	/// Number of riders; defaults to 1.
	passengers?: int @ 1..4,
	/// Seat position in blocks from the mob's feet, `[x, y, z]`; defaults to the top of the
	/// hitbox.
	rider_offset?: [float] @ 3,
	/// A model bone shown only while the mob is saddled.
	saddle_bone?: string,
	/// Event fired when a player mounts the mob; `player` is the rider.
	on_mount?: string,
}

/// How a mob's variant is picked when it spawns.
enum(string) VariantChoice {
	/// A weighted random pick.
	Random = "random",
	/// Variants whose `biomes` hold the spawn position's biome; variants without `biomes` are
	/// the fallback pool; then a weighted random pick.
	Biome = "biome",
}

/// One texture variant of a mob.
struct EntityVariant {
	/// Saved in the mob's data as `Variant`, so `/summon` and `/data` can set it and reordering
	/// the list does not repaint saved mobs; an unknown saved id falls back to the first variant.
	id: string,
	/// Texture id drawn in place of `msm:animated_model.texture`; `ns:entity/x` is
	/// `assets/ns/textures/entity/x.png`.
	texture: #[id="texture"] string,
	/// Weight of the random pick; defaults to 1.
	weight?: int @ 1..,
	/// With `choose` `biome`: biome ids and biome tags (`#`-prefixed) where the variant is picked.
	biomes?: [#[id(registry="worldgen/biome", tags="allowed")] string],
}

/// Texture variants (ADR 0071 D4), picked when the mob spawns and drawn by both renderers. Only
/// textures vary. Runtimes older than the release that ships ADR 0071 ignore the component with
/// a warning.
struct Variants {
	/// Defaults to `random`.
	choose?: VariantChoice,
	/// One to 32 variants.
	variants: [EntityVariant] @ 1..32,
}

/// The colour of a boss bar (vanilla `BossEvent.BossBarColor`).
enum(string) BossBarColour {
	Pink = "pink",
	Blue = "blue",
	Red = "red",
	Green = "green",
	Yellow = "yellow",
	Purple = "purple",
	White = "white",
}

/// The style of a boss bar (vanilla `BossEvent.BossBarOverlay`).
enum(string) BossBarOverlay {
	Progress = "progress",
	Notched6 = "notched_6",
	Notched10 = "notched_10",
	Notched12 = "notched_12",
	Notched20 = "notched_20",
}

/// A boss bar showing the mob's health (ADR 0071 D5), named by its custom or display name. A
/// boss mob does not despawn and is tracked from 10 chunks away. Separate from the scripts' boss
/// bars. Runtimes older than the release that ships ADR 0071 ignore the component with a warning.
struct BossBar {
	/// Defaults to `purple`.
	colour?: BossBarColour,
	/// Defaults to `progress`.
	overlay?: BossBarOverlay,
	/// Whether the sky darkens; defaults to false.
	darken_sky?: boolean,
	/// Whether the world fogs up; defaults to false.
	fog?: boolean,
	/// Whether vanilla's boss music plays; defaults to false.
	music?: boolean,
	/// Players within this many blocks see the bar; absent means every player tracking the mob.
	range?: float @ 8..256,
}

/// Entity components other than `msm:animated_model`, shared with the element data.
struct EntityBehaviourComponents {
	"msm:health"?: Health,
	"msm:movement"?: Movement,
	"msm:attack"?: Attack,
	"msm:ai_goals"?: AiGoals,
	"msm:on_hurt"?: OnHurt,
	"msm:on_death"?: OnDeath,
	/// Fires when a player right-clicks the entity.
	"msm:on_interact"?: OnInteract,
	/// Fires repeatedly while the mob is alive.
	"msm:on_tick"?: OnEntityTick,
	/// Fires when the mob spawns.
	"msm:on_spawn"?: OnSpawn,
	/// Ranged attacks (ADR 0070 D4).
	"msm:ranged_attack"?: RangedAttack,
	/// Taming (ADR 0071 D1); needs `base` `animal`.
	"msm:tameable"?: Tameable,
	/// Breeding and babies (ADR 0071 D2); needs `base` `animal`.
	"msm:breedable"?: Breedable,
	/// Riding (ADR 0071 D3).
	"msm:rideable"?: Rideable,
	/// Texture variants (ADR 0071 D4).
	"msm:variants"?: Variants,
	/// A boss bar (ADR 0071 D5).
	"msm:boss_bar"?: BossBar,
}

/// Runtime entity components; `msm:animated_model` is required.
struct EntityComponents {
	"msm:animated_model": AnimatedModel,
	...EntityBehaviourComponents,
}

/// Fields every entity definition and entity element share, except `spawn_egg` and
/// `components`.
struct EntityCommon {
	/// Definition format; this is version 1.
	format: 1,
	/// The vanilla class the mob builds on (ADR 0070 D1); defaults to `mob`. Runtimes older than
	/// the release that ships ADR 0070 ignore the field with a warning.
	base?: EntityBase,
	/// Spawn group.
	category: MobCategory,
	/// Hitbox size.
	size: EntitySize,
	/// Eye height in blocks; defaults to 0.85 times the height.
	eye_height?: float @ 0..,
	/// Drops; absent means the vanilla default `<ns>:entities/<path>`.
	loot_table?: #[id="loot_table"] string,
	/// Natural spawning; absent means none.
	spawn?: Spawn,
	/// Events that components and actions refer to, by id.
	events?: struct EntityEvents {
		[string]: Event,
	},
	/// Mob sounds (ADR 0057 D6). Absent means the vanilla defaults.
	sounds?: EntitySounds,
}

/// Sound events a mob plays. Every id is a vanilla sound event or a project sound key
/// (`<ns>:<path>` from `assets/<ns>/sounds.json`); an unknown id is a runtime warning and
/// the vanilla default stays. Project sound keys are valid from the runtime version that
/// ships ADR 0057.
struct EntitySounds {
	/// Idle sound; project sound keys are valid from the runtime version that ships ADR 0057.
	ambient?: #[id="sound_event"] string,
	/// Played when the mob is hurt; project sound keys are valid from the runtime version that ships ADR 0057.
	hurt?: #[id="sound_event"] string,
	/// Played when the mob dies; project sound keys are valid from the runtime version that ships ADR 0057.
	death?: #[id="sound_event"] string,
	/// Played on each step; project sound keys are valid from the runtime version that ships ADR 0057.
	step?: #[id="sound_event"] string,
	/// Ticks between ambient sounds (at least 20); absent means vanilla's interval. Valid from the runtime version that ships ADR 0057.
	ambient_interval_ticks?: int @ 20..,
}

/// An entity definition, `msm/<ns>/entity/<path>.json` (ADR 0028 D2).
struct Entity {
	...EntityCommon,
	/// The spawn egg; absent means an egg in `minecraft:spawn_eggs`; `false` means no egg.
	spawn_egg?: (SpawnEgg | false),
	/// Behaviour components; `msm:animated_model` is required.
	components: EntityComponents,
}

/// The category of a mob effect, which sets the colour of its name in tooltips.
enum(string) EffectCategory {
	Beneficial = "beneficial",
	Harmful = "harmful",
	Neutral = "neutral",
}

/// How an attribute modifier combines with the attribute (vanilla `AttributeModifier.Operation`).
enum(string) AttributeOperation {
	/// Adds the amount to the base value.
	AddValue = "add_value",
	/// Adds the amount times the base value.
	AddMultipliedBase = "add_multiplied_base",
	/// Multiplies the total by one plus the amount.
	AddMultipliedTotal = "add_multiplied_total",
}

/// A stat change while the effect is active; the amount is multiplied by the effect level, as
/// vanilla does.
struct EffectAttributeModifier {
	/// The attribute, such as `minecraft:movement_speed`.
	attribute: #[id="attribute"] string,
	/// The amount at level I.
	amount: float,
	operation: AttributeOperation,
}

/// Fires an event once when the effect starts on an entity.
struct OnEffectStart {
	/// An event id declared in `events`.
	event: string,
}

/// Fires an event repeatedly while the effect is active.
struct OnEffectTick {
	/// An event id declared in `events`.
	event: string,
	/// Ticks between two firings; defaults to 20.
	interval_ticks?: int @ 1..,
	/// Whether higher levels fire more often (the interval is divided by the level); defaults
	/// to false.
	faster_per_level?: boolean,
}

/// Fires an event when the effect is removed from an entity.
struct OnEffectEnd {
	/// An event id declared in `events`.
	event: string,
}

/// Mob effect components (ADR 0055 D2). In these events the holder is both `self` and `other`.
struct EffectComponents {
	"msm:on_start"?: OnEffectStart,
	"msm:on_tick"?: OnEffectTick,
	"msm:on_end"?: OnEffectEnd,
}

/// Fields every effect definition and effect element share. The icon is not a field: it is the
/// 18 by 18 texture `assets/<ns>/textures/mob_effect/<path>.png`.
struct EffectCommon {
	/// Definition format; this is version 1.
	format: 1,
	category: EffectCategory,
	/// Colour of the effect's particles and potion bar, as `0xRRGGBB`.
	color: int @ 0..16777215,
	/// A particle type without options shown instead of the tinted swirl.
	particle?: #[id="particle_type"] string,
	/// Sound played when the effect is added.
	sound?: #[id="sound_event"] string,
	/// Stat changes while the effect is active.
	attribute_modifiers?: [EffectAttributeModifier],
	/// Behaviour components.
	components?: EffectComponents,
	/// Events that components refer to, by id. `play_animation` is dropped with a warning.
	events?: struct EffectEvents {
		[string]: Event,
	},
}

/// A mob effect definition, `msm/<ns>/effect/<path>.json` (ADR 0055 D2). Runtimes older than
/// 1.4.0 ignore the `effect` folder with a warning.
struct Effect {
	...EffectCommon,
}

/// One effect of a potion (ADR 0063 D2). Times are ticks; the amplifier is the level minus one.
struct PotionEffect {
	/// Mob effect id, vanilla or a project effect.
	id: #[id="mob_effect"] string,
	duration_ticks: int @ 1..,
	/// Effect level minus one; defaults to 0 (level I).
	amplifier?: int @ 0..255,
	ambient?: boolean,
	show_particles?: boolean,
	show_icon?: boolean,
}

/// A potion definition, `msm/<ns>/potion/<path>.json` (ADR 0063 D2): one `Potion` registry entry.
/// Runtimes older than 1.5.0 (verify at implementation) ignore the `potion` folder with a warning.
struct Potion {
	/// Definition format; this is version 1.
	format: 1,
	/// Name key part of the item name; defaults to `<ns>.<path>`.
	name?: string,
	effects: [PotionEffect] @ 1..8,
}

/// A vanilla `GenerationStep.Decoration` in lower case: when a feature is placed while a chunk
/// generates.
enum(string) GenerationStep {
	RawGeneration = "raw_generation",
	Lakes = "lakes",
	LocalModifications = "local_modifications",
	UndergroundStructures = "underground_structures",
	SurfaceStructures = "surface_structures",
	Strongholds = "strongholds",
	UndergroundOres = "underground_ores",
	UndergroundDecoration = "underground_decoration",
	FluidSprings = "fluid_springs",
	VegetalDecoration = "vegetal_decoration",
	TopLayerModification = "top_layer_modification",
}

/// A placed feature added to the selected biomes' generation settings.
struct BiomeFeature {
	feature: #[id="worldgen/placed_feature"] string,
	step: GenerationStep,
}

/// A natural spawn added to the selected biomes.
struct BiomeSpawn {
	entity: #[id="entity_type"] string,
	/// Spawn group the entry is added to.
	category: MobCategory,
	/// Spawn weight relative to the other spawns of the category.
	weight: int @ 1..,
	/// Smallest group size.
	min_group: int @ 1..,
	/// Largest group size; at least `min_group` (checked by the validators).
	max_group: int @ 1..,
}

/// Fields every biome addition shares.
struct BiomeAdditionCommon {
	/// Definition format; this is version 1.
	format: 1,
	/// Biome ids and biome tags (`#`-prefixed); the addition applies to their union.
	biomes: [#[id(registry="worldgen/biome", tags="allowed")] string] @ 1..,
}

/// A biome addition, `msm/<ns>/biome_addition/<path>.json` (ADR 0060 D2): placed features and
/// natural spawns added to vanilla or other biomes when a server starts. At least one of
/// `features` and `spawns` is required. Only chunks generated afterwards get the features.
type BiomeAddition = (
	struct BiomeFeatureAddition {
		...BiomeAdditionCommon,
		/// Placed features to add.
		features: [BiomeFeature] @ 1..,
		/// Natural spawns to add.
		spawns?: [BiomeSpawn] @ 1..,
	} |
	struct BiomeSpawnAddition {
		...BiomeAdditionCommon,
		/// Placed features to add.
		features?: [BiomeFeature] @ 1..,
		/// Natural spawns to add.
		spawns: [BiomeSpawn] @ 1..,
	}
)

/// A loot addition, `msm/<ns>/loot_addition/<path>.json` (ADR 0060 D3): extra pools added to
/// built-in loot tables on every data pack load. A world data pack that replaces a table wins.
struct LootAddition {
	/// Definition format; this is version 1.
	format: 1,
	/// The loot tables to add to, such as `minecraft:entities/zombie`.
	tables: [#[id="loot_table"] string] @ 1..,
	/// Vanilla loot pools in their JSON form, decoded by the runtime with the game's own pool
	/// Codec. MSM mcdoc cannot name vanilla's pool type with a length bound, so the pools are
	/// checked against the target's loot table schema by the validators.
	pools: [any] @ 1..,
}
