// MSM definition format v1: event actions (ADR 0025 D4).
// Shared by the app (`@msm/schemas`) and the `msm_runtime` mod; the conformance corpus in
// `conformance/` binds both sides. Regenerate `symbols.json` with `node tools/build-msm-mcdoc/index.ts`.

/// The kind of an action. An unknown kind is a load-time error for the definition.
enum(string) ActionType {
	/// Runs a data pack function at the event position.
	RunFunction = "run_function",
	/// Spawns particles at the block centre or the player's position.
	SpawnParticle = "spawn_particle",
	/// Places a block state relative to the event block.
	SetBlockState = "set_block_state",
	/// Gives the player an item; does nothing without a player.
	GiveItem = "give_item",
	/// Plays a sound at the event position.
	PlaySound = "play_sound",
	/// Runs another event of the same definition.
	TriggerEvent = "trigger_event",
	/// Triggers a GeckoLib animation on the event's entity (entity definitions only; ADR 0028 D4).
	PlayAnimation = "play_animation",
	/// Calls a script handler defined with `msm.actions.define` (ADR 0032 D4).
	RunScript = "run_script",
	/// Gives a vanilla mob effect to the player or the other entity of the event (ADR 0044 D2).
	ApplyEffect = "apply_effect",
	/// Pushes the player or the other entity of the event (ADR 0052).
	Launch = "launch",
}

/// Who an `apply_effect` action affects.
enum(string) EffectTarget {
	/// The event's player; in an entity definition without a player, the entity itself.
	Self = "self",
	/// The other entity of the event: the mob an entity hits (`on_attack`), the player who
	/// hurts or interacts with an entity; for block and item events, the player.
	Other = "other",
}

/// Where a `launch` action pushes.
enum(string) LaunchDirection {
	/// Where the target looks, up and down included.
	Look = "look",
	/// Where the target looks, flat along the ground.
	Horizontal = "horizontal",
	/// Straight up.
	Up = "up",
}

/// One action of an event, selected by `type`.
struct Action {
	/// What the action does.
	type: ActionType,
	...msm:action[[type]],
}

/// A named event: actions run in order on the logical server.
struct Event {
	/// Actions to run, in order.
	actions: [Action],
}

/// Runs a data pack function as the player when there is one, with permission level 2.
dispatch msm:action[run_function] to struct RunFunction {
	/// The function to run.
	function: #[id="function"] string,
}

/// Sends particles from the server to nearby players.
dispatch msm:action[spawn_particle] to struct SpawnParticle {
	/// A particle type without options. Defaults are `count` 1, `spread` 0 and `speed` 0.
	particle: #[id="particle_type"] string,
	/// How many particles to spawn.
	count?: int @ 1..,
	/// Random offset from the position, in blocks.
	spread?: float @ 0..,
	/// Particle speed.
	speed?: float @ 0..,
}

/// Places a block state relative to the event block, or to the block below the player for
/// item events.
dispatch msm:action[set_block_state] to struct SetBlockState {
	/// A block state such as `minecraft:oak_stairs[facing=north]`.
	state: string,
	/// Offset `[x, y, z]` from the event block; defaults to `[0, 0, 0]`.
	offset?: [int, int, int],
}

/// Gives the player an item stack.
dispatch msm:action[give_item] to struct GiveItem {
	/// The item to give.
	item: #[id="item"] string,
	/// How many to give; defaults to 1.
	count?: int @ 1..,
}

/// Plays a sound event at the event position.
dispatch msm:action[play_sound] to struct PlaySound {
	/// The sound event to play.
	sound: #[id="sound_event"] string,
	/// Volume; defaults to 1.
	volume?: float @ 0..,
	/// Pitch; defaults to 1.
	pitch?: float @ 0..,
}

/// Runs another event of the same definition. Chains nest at most 16 deep.
dispatch msm:action[trigger_event] to struct TriggerEvent {
	/// An event id declared in this definition's `events`.
	event: string,
}

/// Triggers a GeckoLib animation on the event's entity (ADR 0028 D4). In a block or item
/// definition, or on an entity without GeckoLib loaded, the runtime drops the action at load
/// with a warning and runs the rest of the event.
dispatch msm:action[play_animation] to struct PlayAnimation {
	/// An animation name in the entity's animation file.
	animation: string,
	/// The GeckoLib controller that plays it; defaults to `msm_triggered`.
	controller?: string,
}

/// Calls the script handler defined by `msm.actions.define` with the event context: owner
/// definition id, event id, position, and the block, entity and player when present (ADR 0032
/// D4). An undefined handler is logged once per handler id when the event runs; runtimes older
/// than 0.6.0 reject the action as an unknown type.
dispatch msm:action[run_script] to struct RunScript {
	/// The handler id, a resource location such as `mymod:open_vault`.
	handler: string,
}

/// Gives a vanilla mob effect (ADR 0044 D2). Without a living entity to affect, the action
/// does nothing; runtimes older than 0.8.0 reject it as an unknown type.
dispatch msm:action[apply_effect] to struct ApplyEffect {
	/// The mob effect, such as `minecraft:speed`.
	effect: #[id="mob_effect"] string,
	/// Duration in seconds.
	seconds: float @ 0..,
	/// Effect level minus one; defaults to 0 (level I).
	amplifier?: int @ 0..255,
	/// Defaults to `self`.
	target?: EffectTarget,
}

/// Pushes an entity so the game moves it smoothly, as a slime block or a wind charge does
/// (ADR 0052): `strength` blocks per tick along `direction`, plus `up` blocks per tick
/// upwards. A strength of 1 is a strong dash; vanilla clamps speeds near 10. Runtimes older
/// than 1.4.0 reject it as an unknown type.
dispatch msm:action[launch] to struct Launch {
	/// Speed in blocks per tick along `direction`.
	strength: float @ 0..10,
	/// Defaults to `look`.
	direction?: LaunchDirection,
	/// Extra upward speed in blocks per tick (negative pushes down); defaults to 0.
	up?: float @ -10..10,
	/// `true` adds to the current motion; the default replaces it.
	add?: boolean,
	/// Defaults to `self`.
	target?: EffectTarget,
}
