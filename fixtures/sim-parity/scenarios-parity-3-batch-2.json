{
  "format": 1,
  "namespace": "sim_parity",
  "scenarios": [
    {
      "name": "fluid_cauldron_fills_and_empties",
      "description": "Vanilla's empty cauldron takes a project fluid's bucket (full, level 3); a glass bottle takes a level and the fluid's bottle adds one; an empty bucket takes only a full cauldron; a bottle into an empty cauldron makes level 1.",
      "steps": [
        {"step": "place", "block": "minecraft:cauldron", "pos": [3, -1, 3], "face": "up", "hit": [0.5, 1, 0.5], "yaw": 0, "pitch": 0, "expect": {"blocks": [{"pos": [3, 0, 3], "state": "minecraft:cauldron"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "sim_parity:goo_bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo_cauldron[level=3]"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "minecraft:glass_bottle", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo_cauldron[level=2]"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "minecraft:bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo_cauldron[level=2]"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "sim_parity:goo_bottle", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo_cauldron[level=3]"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "minecraft:bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "minecraft:cauldron"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "sim_parity:goo_bottle", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo_cauldron[level=1]"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "minecraft:glass_bottle", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "minecraft:cauldron"}]}}
      ],
      "events": [],
      "actions": []
    },
    {
      "name": "lava_like_cauldron_is_full_only",
      "description": "A lava-like fluid's cauldron has no levels: a glass bottle does nothing, another bucket replaces what it holds, and an empty bucket takes it back.",
      "steps": [
        {"step": "place", "block": "minecraft:cauldron", "pos": [3, -1, 3], "face": "up", "hit": [0.5, 1, 0.5], "yaw": 0, "pitch": 0, "expect": {"blocks": [{"pos": [3, 0, 3], "state": "minecraft:cauldron"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "sim_parity:magma_bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:magma_cauldron"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "minecraft:glass_bottle", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:magma_cauldron"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "sim_parity:goo_bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo_cauldron[level=3]"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "sim_parity:magma_bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:magma_cauldron"}]}},
        {"step": "use", "pos": [3, 0, 3], "yaw": 0, "item": "minecraft:bucket", "expect": {"blocks": [{"pos": [3, 0, 3], "state": "minecraft:cauldron"}]}}
      ],
      "events": [],
      "actions": []
    },
    {
      "name": "fluid_source_mixes_with_lava",
      "description": "A source of a fluid with a mixing rule becomes the rule's source block when lava comes beside it, and at once when it is poured beside lava.",
      "steps": [
        {"step": "place", "block": "sim_parity:goo_bucket", "pos": [3, -1, 3], "face": "up", "hit": [0.5, 1, 0.5], "yaw": 0, "pitch": 0, "expect": {"blocks": [{"pos": [3, 0, 3], "state": "sim_parity:goo"}]}},
        {"step": "place", "block": "minecraft:lava_bucket", "pos": [4, -1, 3], "face": "up", "hit": [0.5, 1, 0.5], "yaw": 0, "pitch": 0, "expect": {"blocks": [{"pos": [4, 0, 3], "state": "minecraft:lava"}, {"pos": [3, 0, 3], "state": "sim_parity:base"}]}},
        {"step": "place", "block": "sim_parity:goo_bucket", "pos": [5, -1, 3], "face": "up", "hit": [0.5, 1, 0.5], "yaw": 0, "pitch": 0, "expect": {"blocks": [{"pos": [5, 0, 3], "state": "sim_parity:base"}, {"pos": [4, 0, 3], "state": "minecraft:lava"}]}}
      ],
      "events": [],
      "actions": []
    }
  ]
}
