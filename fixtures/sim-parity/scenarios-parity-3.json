          "yaw": 180,
          "item": "minecraft:bone_meal",
          "expect": {
            "blocks": [
              {"pos": [3, 0, 3], "state": "sim_parity:ribbon_plant"},
              {"pos": [3, 1, 3], "state": "sim_parity:ribbon_plant"},
              {"pos": [3, 2, 3], "state": "sim_parity:ribbon"},
              {"pos": [3, 3, 3], "state": "minecraft:air"}
            ]
          }
        }
      ],
      "events": [],
      "actions": []
    },
    {
      "name": "strand_breaks_above_a_gap",
      "description": "Breaking a strand block breaks the strand ahead of it; the block behind turns back into the tip.",
      "steps": [
        {
          "step": "place",
          "block": "sim_parity:ribbon",
          "pos": [3, -1, 3],
          "face": "up",
          "hit": [0.5, 1, 0.5],
          "yaw": 180,
          "pitch": 0
        },
        {
          "step": "place",
          "block": "sim_parity:ribbon",
          "pos": [3, 0, 3],
          "face": "up",
          "hit": [0.5, 1, 0.5],
          "yaw": 180,
          "pitch": 0
        },
        {
          "step": "place",
          "block": "sim_parity:ribbon",
          "pos": [3, 1, 3],
          "face": "up",
          "hit": [0.5, 1, 0.5],
          "yaw": 180,
          "pitch": 0
        },
        {"step": "break", "pos": [3, 1, 3]},
        {
          "step": "wait",
          "ticks": 4,
          "expect": {
            "blocks": [
              {"pos": [3, 0, 3], "state": "sim_parity:ribbon"},
              {"pos": [3, 1, 3], "state": "minecraft:air"},
              {"pos": [3, 2, 3], "state": "minecraft:air"}
            ]
          }
        }
      ],
      "events": [],
      "actions": []
    },
