{
  "format": 1,
  "namespace": "sim_parity",
  "scenarios": [
    {
      "name": "strand_lengthens_on_its_tip",
      "description": "A growing plant placed on its own tip lengthens the strand: the old tip turns into the strand block.",
      "steps": [
        {
          "step": "place",
          "block": "sim_parity:ribbon",
          "pos": [3, -1, 3],
          "face": "up",
          "hit": [0.5, 1, 0.5],
          "yaw": 180,
          "pitch": 0
        },
        {
          "step": "place",
          "block": "sim_parity:ribbon",
          "pos": [3, 0, 3],
          "face": "up",
          "hit": [0.5, 1, 0.5],
          "yaw": 180,
          "pitch": 0,
          "expect": {
            "blocks": [
              {"pos": [3, 0, 3], "state": "sim_parity:ribbon_plant"},
              {"pos": [3, 1, 3], "state": "sim_parity:ribbon"}
            ]
          }
        }
      ],
      "events": [],
      "actions": []
    },
    {
      "name": "strand_grows_by_bone_meal",
      "description": "Bone meal grows a strand by its bonemeal_growth (2) from the tip.",
      "steps": [
        {
          "step": "place",
          "block": "sim_parity:ribbon",
          "pos": [3, -1, 3],
