<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">
  <Appenders>
    <Console name="Out" target="SYSTEM_OUT"><PatternLayout pattern="[%d{HH:mm:ss} %level] [%logger{1}]: %msg%n%xEx"/></Console>
    <File name="File" fileName="logs/latest.log" append="false"><PatternLayout pattern="[%d{HH:mm:ss}] [%t/%level]: %msg%n%xEx"/></File>
  </Appenders>
  <Loggers>
    <Logger name="net.minecraft.network" level="debug"/>
    <Logger name="net.minecraft.server.network" level="debug"/>
    <Root level="info"><AppenderRef ref="Out"/><AppenderRef ref="File"/></Root>
  </Loggers>
</Configuration>
