+	/// it. A block that already has a point of interest type (a vanilla workstation, a bed, a
+	/// bell) is refused (a validator error, and the runtime refuses it too).
+	job_site: #[id="block"] string,
+	/// The trade sets of levels 1 to 5, exactly five; defaults to
+	/// `<ns>:<path>/level_1` to `<ns>:<path>/level_5`, which lowering creates with their tags when
+	/// absent. A missing set gives the villager no offers at that level.
+	trade_sets?: [#[id="trade_set"] string] @ 5,
+	/// Played while the villager works at its job site; absent means none.
+	work_sound?: #[id="sound_event"] string,
+	/// Items the villager picks up and keeps (as a farmer's seeds); defaults to none.
+	requested_items?: [#[id="item"] string],
+	/// Blocks near the job site the villager also works at (as a farmer's farmland); defaults to
+	/// none.
+	secondary_job_blocks?: [#[id="block"] string],
+}
+
+/// A villager profession definition, `msm/<ns>/villager_profession/<path>.json` (ADR 0098 D2): a
+/// job for vanilla villagers, with a point of interest type for every state of its job site.
+/// Runtimes older than the release that ships ADR 0098 ignore the `villager_profession` folder.
+struct VillagerProfession {
+	/// Definition format; this is version 1.
+	format: 1,
+	...VillagerProfessionCommon,
+}
+
+/// Which vanilla liquid a fluid behaves like for entities (ADR 0099 D1).
+enum(string) FluidBehaviour {
+	/// Joins the water fluid tags: entities swim, float, drown and are put out.
+	Water = "water",
+	/// Joins the lava fluid tag: entities are set on fire and hurt as in lava.
+	Lava = "lava",
+	/// Joins no tag: entities move through it as through air or, on targets with one-fluid liquids,
+	/// slowly and without fall damage.
+	None = "none",
+}
+
+/// How a fluid spreads (ADR 0099 D1); defaults follow `behaves_like`: water's 5, 4, 1 and
+/// infinite, lava's 30, 2, 2 and not infinite (`none` takes water's).
+struct FluidFlow {
+	/// Ticks between two flow steps, 1 to 100.
+	tick_delay?: int @ 1..100,
+	/// How far, in blocks, flowing fluid looks for a way down, 1 to 8.
+	slope_distance?: int @ 1..8,
+	/// Levels lost per block of spreading, 1 to 4: the larger, the shorter the flow.
+	drop_off?: int @ 1..4,
+	/// Whether two sources next to each other make a new source.
+	infinite?: boolean,
+}
+
+/// Fields every fluid definition and fluid element share (ADR 0099 D1).
+struct FluidCommon {
+	/// Defaults to `water`.
+	behaves_like?: FluidBehaviour,
+	/// Defaults per `behaves_like`.
+	flow?: FluidFlow,
+	/// Light level of the liquid block, 0 to 15; defaults to 0.
+	light?: int @ 0..15,
+	/// An RGB colour, 0 to 16777215, multiplied over the still, flowing and overlay textures;
+	/// absent means none.
+	tint?: int @ 0..16777215,
+	/// Explosion resistance of the liquid block; defaults to 100, as water's.
+	explosion_resistance?: float @ 0..,
+	/// An event id declared in `events`, fired on the server while an entity is in the fluid, at
+	/// most every 10 ticks for the same entity (ADR 0061).
+	on_entity_inside?: string,
+	/// Events that `on_entity_inside` refers to, by id.
+	events?: struct FluidEvents {
+		[string]: Event,
+	},
+}
+
+/// A fluid definition, `msm/<ns>/fluid/<path>.json` (ADR 0099 D1): the fluid (one registry entry,
+/// or a source and `<ns>:flowing_<path>` on targets that register two), its liquid block under
+/// the same id and its bucket item `<ns>:<path>_bucket`. Runtimes older than the release that
+/// ships ADR 0099 ignore the `fluid` folder.
+struct Fluid {
+	/// Definition format; this is version 1.
+	format: 1,
+	...FluidCommon,
+}
