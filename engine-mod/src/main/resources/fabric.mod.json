{
  "schemaVersion": 1,
  "id": "msm_runtime",
  "version": "${version}",
  "name": "MSM Runtime",
  "description": "Registers blocks, items and entities from msm/ definitions in every loaded mod.",
  "authors": ["MCSuperMods"],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["dev.mcsupermods.runtime.MsmRuntime"],
    "client": ["dev.mcsupermods.runtime.client.MsmRuntimeClient"]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
${geckolib_suggests}
  }
}
